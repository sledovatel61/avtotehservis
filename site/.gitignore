node_modules/
dist/
data/
.env
*.sqlite3
*.sqlite3-*
.astro/

# Загруженные медиа живут на сервере (MEDIA_DIR), в git не попадают.
# Негации ниже перекрывают корневой .gitignore (*.sql, media/) — без них
# в коммит молча не попадают схема БД и маршруты выдачи медиа (блокер Б1/Б2 ревью).
media/
!migrations/
!migrations/*.sql
!src/pages/media/
!src/pages/admin/media/
