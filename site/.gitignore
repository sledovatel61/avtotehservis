node_modules/
dist/
data/
.env
*.sqlite3
*.sqlite3-*
.astro/

# Серверные загрузки живут в site/media (MEDIA_DIR), в git не попадают.
# Негации ниже отменяют корневое правило *.sql для миграций сайта — без них
# в коммит молча не попадают схема БД и маршруты выдачи медиа (блокер Б1/Б2 ревью).
# Фото кейсов лежат в public/media; корневое правило /media/ привязано к корню репозитория.
/media/
!migrations/
!migrations/*.sql
!src/pages/media/
!src/pages/admin/media/

# Генерируемый отчёт ссылок на позиции прайса (npm run build:refs)
public/manage/price-refs.json
