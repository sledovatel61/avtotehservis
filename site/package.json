{
  "name": "avtotehservis-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro build && node ./dist/server/entry.mjs",
    "migrate": "node scripts/migrate.ts",
    "seed": "node scripts/seed.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "seed:demo:clear": "node scripts/seed-demo.ts clear",
    "admin:create": "node scripts/create-admin.ts",
    "test": "npm run build && node --test tests/unit.test.ts tests/integration.test.ts tests/e2e-form.test.ts tests/admin.test.ts && node scripts/check-cascade.mjs && node scripts/check-safe-zone.mjs && node scripts/check-hero-layout.mjs && node scripts/measure-contrast.mjs && node scripts/check-about-panel.mjs && node scripts/check-dirs.mjs && node scripts/check-about-bg.mjs && node scripts/check-steps-bg.mjs && node scripts/check-svc-bg.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "smoke": "node scripts/smoke.mjs",
    "build:pages": "node scripts/export-pages.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "astro": "7.4.1",
    "better-sqlite3": "13.0.3",
    "nodemailer": "10.1.7",
    "sharp": "0.35.5",
    "telegraf": "4.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "jsdom": "^30.1.3",
    "puppeteer-core": "^23.11.1",
    "typescript": "^7.0.2"
  }
}
