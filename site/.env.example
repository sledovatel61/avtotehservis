# Все секреты — только здесь (копия .env на сервере), в git значения не попадают.
# Публичный адрес сайта (canonical, OG, ссылки в письмах/Telegram). Домен не зарегистрирован — для тестов localhost.
PUBLIC_SITE_URL=http://localhost:4321
HOST=127.0.0.1
PORT=4321

# Каталог данных (БД, журнал почты). ВНЕ репозитория: /var/lib/avtotehservis/data
DATA_DIR=./data
# Каталог медиа (загрузки). ВНЕ репозитория и вне public/: /var/lib/avtotehservis/media
MEDIA_DIR=./data/media

# Telegram-бот (токен НИКОГДА не коммитить). TELEGRAM_API_BASE — для тестов с локальной заглушкой.
BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# SMTP (для mail.ru — пароль приложения). SMTP_JSON_DIR — если задан, письма пишутся в каталог (тесты/разработка).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=avtotehservis439@mail.ru
SMTP_JSON_DIR=

# Сессии админки
SESSION_SECRET=

# Лимиты (необязательно; по умолчанию — значения из src/server/ratelimit.ts).
# НЕ оставляйте активных пустых строк VAR= — systemd подставит пустую строку;
# код с round5 трактует её как «не задано» (limitFromEnv), но переменные лучше
# вовсе не создавать. Раскомментируйте и задайте число, только если нужно изменить:
# RATE_LIMIT_LEADS=5         (мягкая квота: УСПЕШНЫХ заявок в час с ключа IP+cookie)
# RATE_LIMIT_LEADS_IP=30     (жёсткая квота: УСПЕШНЫХ заявок в час с одного IP)
# RATE_LIMIT_UPLOADS=30      (загрузок файлов в час с IP)
# RATE_LIMIT_ANTIFLOOD=30    (мягкий антифлуд IP+cookie: любых обращений к /api/leads за 10 минут)
# RATE_LIMIT_ANTIFLOOD_IP=60 (жёсткий антифлуд по IP: любых обращений за 10 минут)

# ffmpeg (необязательно): если доступен — постеры видео генерируются автоматически
FFMPEG_PATH=
