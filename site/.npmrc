# ignore-scripts — осознанное решение, а не обход (пояснение ниже).
#
# better-sqlite3@13.0.3 поставляется с ГОТОВЫМИ бинарниками (prebuilds/ для
# linux-x64, linux-arm64, linuxmusl, darwin, win32) и явно объявляет
# "gypfile": false в своём package.json. Но `npm ci` с lockfileVersion 3 этот
# флаг игнорирует: поле не сохраняется в package-lock.json, npm находит в
# распакованном пакете binding.gyp и по умолчанию запускает `node-gyp rebuild`,
# который скачивает заголовки Node с nodejs.org и компилирует SQLite заново
# (в песочницах без доступа к nodejs.org и без компилятора установка падает).
# `npm install` при этом берёт манифест из реестра (где gypfile:false есть) и
# ничего не собирает — отсюда расхождение «install работает, ci — нет».
#
# В остальном дереве install-скрипты не нужны: единственная зависимость с
# hasInstallScript — fsevents (опциональная, только macOS, на Linux/VPS не
# ставится); sharp, esbuild, rollup, lightningcss подключают платформенные
# optional-пакеты с готовыми бинарниками.
#
# Побочный плюс: ignore-scripts отсекает supply-chain-риск произвольных
# postinstall-скриптов сторонних пакетов (рекомендация npm для серверных стендов).
ignore-scripts=true
