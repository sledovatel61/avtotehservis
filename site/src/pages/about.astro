---
import Base from '../layouts/Base.astro';
import { getSettings } from '../server/settings.ts';
import { listCatalogServices } from '../server/services.ts';
import { listPublishedCases, listPublishedReviews } from '../server/content.ts';
/* круг 23 (§D): шесть фото-обложек кейсов только для «О компании» (галерея главной не тронута) */
const CASE_COVERS: Record<string, { avif: string; webp: string; alt: string }> = {
  'case-1': { avif: '/img/ab-case-1-640.avif', webp: '/img/ab-case-1-640.webp', alt: 'Иллюстрация: боковой порез шины на монтажном станке' },
  'case-2': { avif: '/img/ab-case-2-640.avif', webp: '/img/ab-case-2-640.webp', alt: 'Иллюстрация: грыжа на боковине шины перед вулканизацией' },
  'case-3': { avif: '/img/ab-case-3-640.avif', webp: '/img/ab-case-3-640.webp', alt: 'Иллюстрация: пример работы сервиса — подвеска и колесо' },
  'case-4': { avif: '/img/ab-case-4-640.avif', webp: '/img/ab-case-4-640.webp', alt: 'Иллюстрация: суппорт и тормозные колодки при замене' },
  'case-5': { avif: '/img/ab-case-5-640.avif', webp: '/img/ab-case-5-640.webp', alt: 'Иллюстрация: слив отработанного масла и фильтр при ТО' },
  'case-6': { avif: '/img/ab-case-6-640.avif', webp: '/img/ab-case-6-640.webp', alt: 'Иллюстрация: пример работы сервиса — узлы трансмиссии' },
};
import { fmtDateRu, plural } from '../server/format.ts';

const S = getSettings();
const services = listCatalogServices();
const cases = listPublishedCases(6);
const reviews = listPublishedReviews(8);
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'О компании' },
  ],
};
---
<Base
  page="about"
  title="Как работают мастера АвтоТехСервиса — Портовая, 439"
  description="Шесть мастеров, понятный порядок работ и сертификаты четырёх брендов. АвтоТехСервис на Портовой, 439, Ростов-на-Дону."
  jsonLd={jsonLd}
>

<nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">О компании</span></nav>
<section class="page-head">
  <div class="abh-bg" aria-hidden="true">
    <picture>
      <source media="(max-width:900px)" srcset="/img/ab-head-m.avif" type="image/avif">
      <source media="(max-width:900px)" srcset="/img/ab-head-m.webp" type="image/webp">
      <source srcset="/img/ab-head.avif" type="image/avif">
      <img src="/img/ab-head.webp" alt="" width="1376" height="688" loading="eager" fetchpriority="high" decoding="async">
    </picture>
  </div>
  <div class="container">
    <span class="eyebrow">О компании</span>
    <h1>Шесть мастеров и понятный порядок работ</h1>
    <p class="lead">«АвтоТехСервис» — автосервис и шиномонтаж в Ростове-на-Дону: улица Портовая, 439, Западный жилой массив. Работаем ежедневно, без выходных, с 9:00 до 19:00.</p>
    <p class="lead u-mt14">Телефоны: <a class="u-brass" href="tel:+79289065700">+7 (928) 906-57-00</a>, <a class="u-brass" href="tel:+78632291950">+7 (863) 229-19-50</a> и <a class="u-brass" href="tel:+79518265847">+7 (951) 826-58-47</a>.</p>
  </div>
</section>
<section class="sec" aria-labelledby="ab-text-h">
  <div class="ab-text-bg" aria-hidden="true">
    <picture>
      <source media="(max-width:1180px)" srcset="/img/ab-t-m.avif" type="image/avif">
      <source media="(max-width:1180px)" srcset="/img/ab-t-m.webp" type="image/webp">
      <source srcset="/img/ab-t.avif" type="image/avif">
      <img src="/img/ab-t.webp" alt="" width="1068" height="768" loading="lazy" decoding="async">
    </picture>
  </div>
  <div class="container about-grid">
    <div class="reveal">
      <h2 id="ab-text-h">АвтоТехСервис на Портовой, 439</h2>
      <p class="lead">«АвтоТехСервис» — автосервис и шиномонтаж в Ростове-на-Дону по адресу: улица Портовая, 439. Мы на Западном жилом массиве, в Железнодорожном районе. От остановки «3-й Поселковый» до нас около 330 метров; рядом находится продуктовая база «Бум». Работаем ежедневно, без выходных, с 9:00 до 19:00.</p>
      <p class="lead u-mt14">Обслуживаем легковые автомобили, кроссоверы и паркетники. Выполняем шиномонтаж, ремонт и балансировку колёс, ТО, замену масла, ремонт тормозов и подвески, работы с рулевым управлением, ГРМ, сцеплением, ШРУСами и ступичными подшипниками. Проводим диагностику, заправляем кондиционеры и обслуживаем систему. Если не уверены, подойдёт ли ваш автомобиль для этой работы, позвоните до визита.</p>
      <h2>Сначала осмотр, затем решение</h2>
      <p class="lead">Уточняем, что беспокоит, осматриваем автомобиль или предлагаем диагностику. Диагностика ходовой — 500 ₽, компьютерная — 800 ₽. Объясняем результат и называем стоимость работ до начала.</p>
      <details class="ab-acc">
        <summary><h2>Сервис, в котором всё проговаривают</h2></summary>
        <p class="lead">Вы описываете проблему, мастер осматривает автомобиль, мы сообщаем результаты и смету. Если обнаружится дополнительная работа, сначала объясним и согласуем её. После ремонта выдаём автомобиль, рассказываем о выполненном и оформляем заказ-наряд. Отделяем необходимое сейчас от того, что можно запланировать. По возможности показываем снятую деталь и объясняем, почему нужна замена. Если причина неочевидна, предлагаем проверку, а не делаем вывод по одному описанию.</p>
      </details>
      <div class="facts">
        <div class="fact"><b>{S.address_full}</b><span>ост. «3-й Поселковый» ~330 м · база «Бум» рядом</span></div>
        <div class="fact"><b>{S.hours}</b><span>без выходных</span></div>
        <div class="fact"><b>ИП Яковенко П. И.</b><span>ИНН {S.legal.inn} · ОГРНИП {S.legal.ogrnip}</span></div>
        <div class="fact"><b>Шесть мастеров посменно</b><span>состав смены зависит от дня</span></div>
      </div>
    </div>
    <figure class="about-media reveal" data-d="1">
      <picture>
        <source type="image/avif" srcset="/img/ab-media-480.avif 480w, /img/ab-media-720.avif 720w, /img/ab-media-1080.avif 1080w" sizes="(max-width:768px) 92vw, (max-width:1024px) 64vw, 526px">
        <source type="image/webp" srcset="/img/ab-media-480.webp 480w, /img/ab-media-720.webp 720w, /img/ab-media-1080.webp 1080w" sizes="(max-width:768px) 92vw, (max-width:1024px) 64vw, 526px">
        <img src="/img/ab-media-720.webp" alt="Автомобиль на подъёмнике в боксе сервиса" width="1080" height="675" loading="lazy" decoding="async">
      </picture>
      <figcaption>Иллюстрация: рабочий пост на два подъёмника</figcaption>
    </figure>
  </div>
</section>
<section class="sec sec--deep ab-feats" aria-labelledby="ab-feats-h">
  <div class="ab-feats-bg" aria-hidden="true">
    <picture>
      <source media="(max-width:640px)" srcset="/img/ab-feats-m.avif" type="image/avif">
      <source media="(max-width:640px)" srcset="/img/ab-feats-m.webp" type="image/webp">
      <source srcset="/img/ab-feats.avif" type="image/avif">
      <img src="/img/ab-feats.webp" alt="" width="1365" height="768" loading="lazy" decoding="async">
    </picture>
  </div>
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Преимущества</span>
      <h2 id="ab-feats-h">Четыре причины записаться именно сюда</h2>
    </div>
    <div class="feats u-mt0">
      <div class="feat reveal" data-d="0"><div class="feat-bg" aria-hidden="true"><picture><source type="image/avif" srcset="/img/ab-f1-640.avif"><source type="image/webp" srcset="/img/ab-f1-640.webp"><img src="/img/ab-f1-640.webp" alt="" width="640" height="480" loading="lazy" decoding="async"></picture></div><span class="feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span><div class="feat-txt"><h3>Цена известна до работ</h3><p>Сначала осматриваем автомобиль и согласуем стоимость. Приступаем только к тому объёму, который вы подтвердили.</p></div></div>
      <div class="feat reveal" data-d="1"><div class="feat-bg" aria-hidden="true"><picture><source type="image/avif" srcset="/img/ab-f2-640.avif"><source type="image/webp" srcset="/img/ab-f2-640.webp"><img src="/img/ab-f2-640.webp" alt="" width="640" height="480" loading="lazy" decoding="async"></picture></div><span class="feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span><div class="feat-txt"><h3>Официальная точка продаж четырёх брендов</h3><p>Сертификаты LYNXauto, SUFIX, KORSON и NGN действуют до 23.06.2027. Документы подтверждают официальный статус точки продаж.</p></div></div>
      <div class="feat reveal" data-d="2"><div class="feat-bg" aria-hidden="true"><picture><source type="image/avif" srcset="/img/ab-f3-640.avif"><source type="image/webp" srcset="/img/ab-f3-640.webp"><img src="/img/ab-f3-640.webp" alt="" width="640" height="480" loading="lazy" decoding="async"></picture></div><span class="feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span><div class="feat-txt"><h3>Шесть мастеров работают посменно</h3><p>Команда принимает автомобили в собственном боксе. Состав смены зависит от дня — время визита можно уточнить при записи.</p></div></div>
      <div class="feat reveal" data-d="3"><div class="feat-bg" aria-hidden="true"><picture><source type="image/avif" srcset="/img/ab-f4-640.avif"><source type="image/webp" srcset="/img/ab-f4-640.webp"><img src="/img/ab-f4-640.webp" alt="" width="640" height="480" loading="lazy" decoding="async"></picture></div><span class="feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13v11H1zM14 9h4l4 4v4h-8z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/></svg></span><div class="feat-txt"><h3>Открыты каждый день</h3><p>Работаем без выходных, ежедневно с 9:00 до 19:00. Адрес: Ростов-на-Дону, Портовая, 439, Западный жилой массив.</p></div></div>
    </div>
  </div>
</section>
<section class="sec sec--ivory" aria-labelledby="ab-cert-h">
  <div class="container">
    <div class="sec-head reveal">
      <div><span class="eyebrow">Сертификаты</span><h2 id="ab-cert-h">Документы на продукцию LYNXauto, SUFIX, KORSON и NGN</h2></div>
    </div>
    <p class="lead">Сертификаты оформлены на «АвтоТехСервис», Портовая, 439, и действуют до 23.06.2027. Для клиента это подтверждение официального канала продукции и дополнительный ориентир по качеству расходных материалов и деталей, используемых в сервисе.</p>
    <div class="certs">
      <figure class="cert">
        <picture>
          <source type="image/avif" srcset="/img/cert-lynxauto-720.avif 720w, /img/cert-lynxauto-1200.avif 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <source type="image/webp" srcset="/img/cert-lynxauto-720.webp 720w, /img/cert-lynxauto-1200.webp 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <img src="/img/cert-lynxauto-720.webp" alt="Иллюстрация: оформленный сертификат LYNXauto" width="720" height="960" loading="lazy" decoding="async">
        </picture>
        <figcaption><b>LYNXauto</b><span>Akita Kaihatsu G.K., Япония</span></figcaption>
      </figure>
      <figure class="cert">
        <picture>
          <source type="image/avif" srcset="/img/cert-sufix-720.avif 720w, /img/cert-sufix-1200.avif 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <source type="image/webp" srcset="/img/cert-sufix-720.webp 720w, /img/cert-sufix-1200.webp 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <img src="/img/cert-sufix-720.webp" alt="Иллюстрация: оформленный сертификат SUFIX" width="720" height="960" loading="lazy" decoding="async">
        </picture>
        <figcaption><b>SUFIX</b><span>ООО «ЛН Дистрибьюция»</span></figcaption>
      </figure>
      <figure class="cert">
        <picture>
          <source type="image/avif" srcset="/img/cert-korson-720.avif 720w, /img/cert-korson-1200.avif 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <source type="image/webp" srcset="/img/cert-korson-720.webp 720w, /img/cert-korson-1200.webp 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <img src="/img/cert-korson-720.webp" alt="Иллюстрация: оформленный сертификат KORSON" width="720" height="960" loading="lazy" decoding="async">
        </picture>
        <figcaption><b>KORSON</b><span>TREUS OTOMOTIV, Анталья, Турция</span></figcaption>
      </figure>
      <figure class="cert">
        <picture>
          <source type="image/avif" srcset="/img/cert-ngn-720.avif 720w, /img/cert-ngn-1200.avif 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <source type="image/webp" srcset="/img/cert-ngn-720.webp 720w, /img/cert-ngn-1200.webp 1200w" sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 260px">
          <img src="/img/cert-ngn-720.webp" alt="Иллюстрация: оформленный сертификат NGN" width="720" height="960" loading="lazy" decoding="async">
        </picture>
        <figcaption><b>NGN</b><span>официальная точка продаж</span></figcaption>
      </figure>
    </div>
    <p class="lead u-mt14">Цены на работы, примеры стоимости и правила — на странице <a href="/prices" class="u-brass">прайса</a>; как мы ведём себя с клиентом — на странице <a href="/garantii" class="u-brass">гарантий</a>.</p>
    <p class="cert-note">Здесь показаны иллюстрации в стиле сервиса, а не сканы документов: оформленные сертификаты можно посмотреть в сервисе на Портовой, 439.</p>
  </div>
</section>
<section class="sec" aria-labelledby="ab-gal-h">
  <div class="container">
    <div class="sec-head reveal">
      <div><span class="eyebrow">Работы</span><h2 id="ab-gal-h">Примеры кейсов</h2></div>
      <div class="slider-nav">
        <button class="hero-arrow" type="button" data-car="prev" aria-label="Предыдущие кейсы">←</button>
        <button class="hero-arrow" type="button" data-car="next" aria-label="Следующие кейсы">→</button>
      </div>
    </div>
    <div class="carousel reveal" data-carousel>
      <div class="carousel-win"><div class="carousel-track gal-track">
          {cases.map((c, ci) => {
            /* круг 23 (§D): обложки кейсов на «О компании» — фото-иллюстрации работы по теме
               кейса; бейдж «до / после» убран (обложка не обещает фото конкретной машины) */
            const cv = CASE_COVERS[c.slug] ?? CASE_COVERS['case-1'];
            return (
              <button class="gal-card" type="button" data-gal={ci} data-img={cv.webp} data-title={c.title} data-sub={c.description ?? ''} aria-label={`Открыть кейс: ${c.title}`}>
                <span class="gal-img"><picture>
                  <source type="image/avif" srcset={cv.avif}>
                  <img src={cv.webp} sizes="(max-width:640px) 84vw, (max-width:1024px) 44vw, 380px" alt={cv.alt} width="640" height="480" loading="lazy" decoding="async">
                </picture></span>
                <span class="gal-cap gal-cap--case"><span>{c.title}</span><span class="ba">пример работы</span></span>
              </button>
            );
          })}
          </div></div>
    </div>
  </div>
</section>
<section class="sec sec--deep" aria-labelledby="ab-rev-h">
  <div class="container">
    <div class="sec-head reveal">
      <div><span class="eyebrow">Отзывы</span><h2 id="ab-rev-h">Отзывы клиентов на Яндекс Картах</h2></div>
      {/* круг 26 (minor 5.6 A6): при одной карточке листать нечего — стрелок нет */}
      {reviews.length > 1 && (
        <div class="slider-nav">
          <button class="hero-arrow" type="button" data-car="prev" aria-label="Предыдущие отзывы">←</button>
          <button class="hero-arrow" type="button" data-car="next" aria-label="Следующие отзывы">→</button>
        </div>
      )}
    </div>
    <div class="carousel reveal" data-carousel>
      <div class="carousel-win"><div class="carousel-track">
          {reviews.length === 0 ? (
            <article class="rev-card">
              <div class="rev-text"><p>Читайте отзывы на Яндекс.Картах — там же оценки и схема проезда.</p></div>
              <div class="rev-who">
                <span class="rev-ava" aria-hidden="true">Я</span>
                <span><b>Яндекс.Карты</b><span><a class="linklike" href={S.ratings[0]?.url || S.map_link} target="_blank" rel="noopener noreferrer" aria-label="Отзывы об АвтоТехСервис на Яндекс.Картах">Открыть Яндекс Карты</a></span></span>
              </div>
            </article>
          ) : reviews.map((r) => (
            <article class="rev-card">
              <span class="rev-stars" role="img" aria-label={`Оценка ${r.rating ?? 5} из 5`}>{Array.from({ length: r.rating ?? 5 }).map(() => (<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z"/></svg>))}</span>
              <div class="rev-text"><p>{r.text}</p></div>
              <div class="rev-who">
                <span class="rev-ava" aria-hidden="true">{r.author.slice(0, 1)}</span>
                <span><b>{r.author}</b><span>{[r.source, r.published_at ? fmtDateRu(r.published_at) : ''].filter(Boolean).join(' · ')}</span></span>
              </div>
            </article>
          ))}
          </div></div>
    </div>
    <p class="rate-note">Своих отзывов не пишем и чужие не переносим. Оценки и живые отзывы о сервисе — на Яндекс.Картах: там же карточка с адресом, часами и схемой проезда.</p>
  </div>
</section>
<section class="sec" aria-labelledby="brands-h">
  <div class="container">
    <div class="sec-head sec-head--center reveal">
      <span class="eyebrow">Марки</span>
      <h2 id="brands-h">Работаем с легковыми автомобилями</h2>
    </div>
  </div>
  <div class="marq reveal" aria-label="Марки автомобилей (бегущая строка)">
    <div class="marq-in">
      {[...S.brands, ...S.brands].map((b, bi) => (
        <span class="brand-chip" aria-hidden={bi >= S.brands.length ? 'true' : 'false'}>{b}</span>
      ))}
    </div>
  </div>
  <div class="container"><p class="marq-note">Перед записью позвоните, если хотите уточнить, берёмся ли за нужную вам работу.</p></div>
</section>

  <script>import '../client/lightbox.ts';</script>
</Base>
