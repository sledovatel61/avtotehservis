const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Voyah Free', item: siteUrl + '/voyah-free' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'ТО и ремонт Voyah Free',
    serviceType: 'Техническое обслуживание Voyah Free',
    areaServed: 'Ростов-на-Дону',
    provider: {
      '@type': 'AutoRepair',
      name: S.site_name,
      telephone: S.phone_main_tel,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ростов-на-Дону',
        streetAddress: 'ул. Портовая, 439',
        addressCountry: 'RU',
      },
    },
    /* круг 29 (M2): «от 2500 ₽» отдавалось как фиксированные 2500 — для других
       креплений цена выше. Цены «от» идут через priceSpecification.minPrice. */
    offers: PRICE.map(([name, sub, sum]) => {
      const digits = sum.replace(/[^\d]/g, '');
      const base = { '@type': 'Offer', name: sub ? `${name} (${sub})` : name, priceCurrency: 'RUB' };
      return /^от\s/.test(sum)
        ? { ...base, priceSpecification: { '@type': 'PriceSpecification', minPrice: digits, priceCurrency: 'RUB' } }
        : { ...base, price: digits };
    }),
  },
];
