---
/* Круг 26 (задание №30 §2.3): страница прайса. Тексты и цифры — content/merged-r26/a7/02-prices.md
   целиком: вводный абзац, 6 групп с примечаниями, 5 сносок, FAQ из 4 вопросов.
   Таблицы рендерятся статически (markdown-парсер сайта таблицы не умеет). */
import Base from '../layouts/Base.astro';
import { getSettings } from '../server/settings.ts';

const S = getSettings();
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');

const GROUPS = [
  {
    id: 'to', h: 'ТО и жидкости', svc: 'to-maslo',
    rows: [
      ['Замена масла в двигателе, седан', '1000–1300 ₽'],
      ['Замена масла в двигателе, кроссовер', '1300–1500 ₽'],
      ['Замена масла в МКПП', '1500 ₽'],
      ['Замена масла в АКПП (в том числе вариатор)', '1500–3000 ₽'],
      ['Замена тормозной жидкости', '1500 ₽'],
      ['Замена антифриза', '1500 ₽'],
    ],
    note: 'Разброс по маслу в АКПП — самый большой во всём прайсе (1500/2500/3000 ₽). Причина — объём и конструкция коробки: где-то масло меняется частично, где-то со снятием поддона. Причина разброса по маслу в двигателе проще — класс автомобиля.',
  },
  {
    id: 'tormoza', h: 'Тормоза', svc: 'tormoza',
    rows: [
      ['Замена передних тормозных колодок', '1200 ₽'],
      ['Замена заднего тормозного диска', '1200 ₽'],
      ['Замена барабана', '2000–2500 ₽'],
      ['Замена дисков вместе с колодками', '2200–4000 ₽'],
      ['Электрический стояночный тормоз', '2500 ₽'],
    ],
    note: '«Диски вместе с колодками» дороже, чем две отдельные строки, потому что в эту работу входит разборка суппорта и обслуживание направляющих. Электрический стояночный тормоз — отдельная работа: привод нужно переводить в сервисный режим, и это меняет последовательность разборки.',
  },
  {
    id: 'podveska', h: 'Подвеска и рулевое', svc: 'podveska',
    rows: [
      ['Амортизаторы, передние', '1800–2500 ₽'],
      ['Амортизаторы, задние', '1200–2000 ₽'],
      ['Рычаг передний', '1500–2000 ₽'],
      ['Шаровая опора', '1000–2000 ₽'],
      ['Сайлентблоки передних рычагов', '2300–2500 ₽'],
      ['Сайлентблоки балки', '6000–7000 ₽'],
      ['Втулки стабилизатора, передние и задние', '1000–3500 ₽'],
      ['Стойки стабилизатора, передние и задние', '1000–1300 ₽'],
      ['Рулевой наконечник', '800 ₽'],
      ['Рулевая тяга', '1800 ₽'],
      ['Ступичный подшипник', '2000–2500 ₽'],
    ],
    note: 'Сайлентблоки балки — самая дорогая позиция в подвеске, потому что балку снимают целиком. Прежде чем соглашаться, имеет смысл начать с диагностики ходовой за 500 ₽: часто стук, на который жалуются, дают не балка, а стойки стабилизатора за 1000–1300 ₽.',
  },
  {
    id: 'grm', h: 'Двигатель, ГРМ, привод, сцепление', svc: 'grm-sceplenie',
    rows: [
      ['Ремень ГРМ, ВАЗ 8 клапанов', '3500–4500 ₽'],
      ['Ремень ГРМ, ВАЗ 16 клапанов', '5000–6000 ₽'],
      ['Ремень ГРМ, Поло / Шкода', '8000 ₽'],
      ['Ремень ГРМ, Форд', '8000–9000 ₽'],
      ['Цепь ГРМ, Солярис / Рио', '15 000 ₽'],
      ['Сцепление, ВАЗ', '6000 ₽'],
      ['Сцепление, Акцент', '8000 ₽'],
      ['Сцепление, Форд / Мазда', '9000 ₽'],
      ['Сцепление, кроссовер, полный привод', '12 000–16 000 ₽'],
      ['Замена обводного ремня', '1200–2500 ₽'],
      ['Замена бензонасоса', '2500–5000 ₽'],
      ['ШРУС наружный', '2000–2500 ₽'],
      ['ШРУС внутренний', '2500–3000 ₽'],
    ],
    note: 'У ремня ГРМ на ВАЗ две цены не случайно — на доске рядом с цифрами стоит «помпа/без», то есть с заменой водяного насоса и без неё. Насколько работа подорожает, зависит от того, меняем ли помпу вместе с ремнём; это обсуждаем до разборки, а не после. На Солярисе и Рио в приводе ГРМ стоит не ремень, а цепь — это отдельная работа и отдельная строка прайса.',
  },
  {
    id: 'diagnostika', h: 'Диагностика', svc: 'diagnostika',
    rows: [
      ['Диагностика ходовой', '500 ₽'],
      ['Компьютерная диагностика', '800 ₽'],
    ],
    note: 'Диагностика — отдельная работа, она оплачивается независимо от того, ремонтируетесь вы у нас или нет. Зато после неё у вас на руках список того, что действительно требует внимания.',
  },
];

const TYRE_SET = [
  ['R13', '1800 ₽', '2000 ₽'], ['R14', '1800 ₽', '2000 ₽'], ['R15', '2000 ₽', '2200 ₽'],
  ['R16', '2200 ₽', '2400 ₽'], ['R17', '2400 ₽', '2600 ₽'], ['R18', '2800 ₽', '3200 ₽'],
  ['R19', '3000 ₽', '3400 ₽'], ['R20', '3600 ₽', '4000 ₽'],
];
const WHEEL_REPAIR = [['R13–R15', '600 ₽'], ['R16–R17', '800 ₽'], ['R18–R20', '1000 ₽']];
const TYRE_EXTRA = [
  ['Смена колёс, седан', '1000 ₽'],
  ['Смена колёс, паркетник / кроссовер / джип', '1000 ₽'],
  ['Балансировка колёс, R13–R16', '800 ₽'],
  ['Балансировка колёс, R17–R20', '1000 ₽'],
];
const SHINY_NOTE = 'Цены за комплект из четырёх колёс — и сезонная смена шин, и смена колёс. Ремонт колеса — за одно колесо. «Сезонная смена шин» и «смена колёс» — две разные позиции: первая, когда шины переставляют с диска на диск, вторая, когда меняют готовый комплект колёс в сборе. Если вы привезли второй комплект на дисках, вам нужна вторая строка за 1000 ₽. Балансировка — отдельная строка прайса, в радиусную цену она не входит.';

const FOOTNOTES = [
  'Цены — на работы. Расходные материалы и детали в эти суммы не входят.',
  'Диапазон A–B ₽ означает одну и ту же работу для разных автомобилей или разного объёма разборки. Какой именно вариант ваш — скажем после осмотра.',
  'Прайс совпадает с тем, что висит в боксе, и с публикацией в Яндекс.Справке. Актуальность цифр проверена 05.11.2026.',
  'Точную сумму называем до начала работ. Работы, которые не согласованы, не делаем.',
  'Если работы нет в этом списке — позвоните: возможно, мы её делаем, просто она не попала в прайс на стене.',
];

const FAQ = [
  {
    q: 'Почему одна и та же работа стоит по-разному для разных машин?',
    a: 'Потому что на разных машинах это разная работа, и главное — разное крепление. Передние амортизаторы на одной модели снимаются просто, на другой приходится разбирать больше: поэтому 1800–2500 ₽. Рычаг передний — 1500–2000 ₽ по той же причине, это разная сложность. Плюс класс автомобиля и объём: масло в седане и в кроссовере, ремень ГРМ на ВАЗ с помпой и без неё. Диапазон в прайсе — честная вилка, а не «как получится».',
  },
  {
    q: 'Это цены с запчастями?',
    a: 'Нет. В прайсе — стоимость работы; расходные материалы и детали в неё не входят. Гарантия на работу и гарантия на деталь — разные вещи: что и на сколько мы гарантируем, написано в заказ-наряде.',
  },
  {
    q: 'Когда я узнаю окончательную сумму?',
    a: 'До начала работ. Схема такая: осмотр — перечень работ — цена — ваше «да». Если во время ремонта выяснится что-то ещё (например, под пыльником ШРУСа обнаружится люфт), мы останавливаемся и сначала звоним. Работы, которую вы не одобрили, не будет.',
  },
  {
    q: 'Сколько времени займёт ремонт?',
    a: 'Зависит от работы и от того, что покажет осмотр. Замена колодок или масла — это один визит и обычно немного времени. Сцепление, сайлентблоки балки, цепь ГРМ на Солярисе — работы на день и больше, их лучше планировать заранее. Сроки назовём вместе с ценой, до того как вы оставите машину.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Прайс' },
    ],
  },
];
---
<Base
  page="prices"
  title="Прайс автосервиса на Портовой, 439 — цены на работы"
  description="Прайс автосервиса в Ростове-на-Дону: ТО, тормоза, подвеска, ГРМ и сцепление, шиномонтаж. Цены на работы, ежедневно 9:00–19:00."
  jsonLd={jsonLd}
>

<nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">Прайс</span></nav>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Прайс</span>
    <h1>Прайс на работы</h1>
    <p class="lead">Это весь прайс, который висит у нас в боксе. Цены — на работы; машину берём под ключ, от диагностики до выдачи. Запчасти и расходники в эти суммы не входят: масло, колодки, ремень, помпа и фильтры считаются отдельно. Если напротив работы стоит диапазон, значит она зависит от автомобиля — конструкция и крепление узлов на разных машинах отличаются, точную сумму назовём до начала работ, после осмотра.</p>
    <p class="lead u-mt14">Для ориентира: замена масла в двигателе — от 1000 ₽ на седане и от 1300 ₽ на кроссовере, шиномонтаж комплекта R16 — 2200 ₽ за четыре колеса, диагностика ходовой — 500 ₽. Это примеры стоимости именно работы; по вашему автомобилю сумму подтвердим до начала.</p>
  </div>
</section>
<nav class="price-nav container" aria-label="Группы прайса">
  <a class="price-nav-a" href="#to">ТО и жидкости</a>
  <a class="price-nav-a" href="#tormoza">Тормоза</a>
  <a class="price-nav-a" href="#podveska">Подвеска и рулевое</a>
  <a class="price-nav-a" href="#grm">ГРМ и сцепление</a>
  <a class="price-nav-a" href="#diagnostika">Диагностика</a>
  <a class="price-nav-a" href="#shiny">Шины и колёса</a>
</nav>
<section class="sec sec--tight" aria-labelledby="prices-h">
  <div class="container">
    <h2 id="prices-h" class="u-sr">Группы работ и стоимости</h2>
    {GROUPS.map((g, gi) => (
      <div class="price-grp" id={g.id}>
        <h3><span class="n" aria-hidden="true">{gi + 1}.</span> {g.h}</h3>
        <div class="price-wrap">
          <table class="price-tbl">
            <thead><tr><th scope="col">Работа</th><th scope="col">Стоимость работ</th></tr></thead>
            <tbody>
              {g.rows.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td></tr>))}
            </tbody>
          </table>
        </div>
        <p class="price-note-txt">{g.note}</p>
        <p class="price-svc"><a class="u-brass" href={`/services/${g.svc}`}>Страница услуги: {g.h}</a></p>
      </div>
    ))}
    <div class="price-grp" id="shiny">
      <h3><span class="n" aria-hidden="true">6.</span> Шины и колёса</h3>
      <p class="price-sub">Сезонная смена шин — за комплект из четырёх колёс</p>
      <div class="price-wrap">
        <table class="price-tbl">
          <thead><tr><th scope="col">Радиус</th><th scope="col">Легковые</th><th scope="col">Кроссовер, паркетник</th></tr></thead>
          <tbody>
            {TYRE_SET.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="price-sub">Ремонт колеса — за одно колесо</p>
      <div class="price-wrap">
        <table class="price-tbl">
          <thead><tr><th scope="col">Радиус</th><th scope="col">Стоимость работ</th></tr></thead>
          <tbody>
            {WHEEL_REPAIR.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="price-sub">Отдельные позиции</p>
      <div class="price-wrap">
        <table class="price-tbl">
          <thead><tr><th scope="col">Работа</th><th scope="col">Стоимость работ</th></tr></thead>
          <tbody>
            {TYRE_EXTRA.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="price-note-txt">{SHINY_NOTE}</p>
      <p class="price-svc"><a class="u-brass" href="/services/shinomontazh">Страница услуги: шиномонтаж</a> · <a class="u-brass" href="/services/balansirovka">балансировка и ремонт колёс</a></p>
    </div>
    <div class="price-foot">
      <ol>
        {FOOTNOTES.map((f) => (<li>{f}</li>))}
      </ol>
    </div>
  </div>
</section>
<section class="sec sec--deep sec--narrow" aria-labelledby="price-faq-h">
  <div class="container">
    <div class="sec-head reveal">
      <div><span class="eyebrow">Вопросы о ценах</span><h2 id="price-faq-h">Что спрашивают по телефону чаще всего</h2></div>
    </div>
    <div class="faq">
      {FAQ.map((f) => (
        <details class="ab-acc">
          <summary><h3>{f.q}</h3></summary>
          <p class="lead">{f.a}</p>
        </details>
      ))}
    </div>
    <p class="u-chips-mt26">
      <a class="btn btn--copper" href="/appointment">Записаться на визит</a>
      <a class="btn btn--ghost" href={`tel:${S.phone_main_tel}`} data-track="call_click">Позвонить: {S.phone_main}</a>
    </p>
  </div>
</section>

</Base>
