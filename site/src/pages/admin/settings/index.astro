---
import Admin from '../../../layouts/Admin.astro';
import { getSettings, setSetting } from '../../../server/settings.ts';
import { normalizePhone } from '../../../server/validation.ts';

/** Телефон для href="tel:" — нормализованный +7…, а не голые цифры (minor-2 ревью round4). */
function telNorm(raw: string): string {
  const n = normalizePhone(raw);
  if (n) return n;
  const d = raw.replace(/\D/g, '');
  return d ? '+' + d : '';
}
import { sessionFromContext, csrfValidForm, csrfRefusal, logAction, ensureCsrfCookie } from '../../../server/admin-auth.ts';
import { db } from '../../../server/db.ts';

const user = sessionFromContext(Astro)!;
const csrf = ensureCsrfCookie(Astro);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  if (!form || !(await csrfValidForm(Astro, form))) return csrfRefusal(Astro);
  const str = (k: string): string => String(form.get(k) ?? '').trim();
  const num = (k: string, dflt: number): number => { const n = Number(str(k)); return Number.isFinite(n) ? n : dflt; };
  const tx = db().transaction(() => {
    setSetting('site_name', str('site_name') || 'АвтоТехСервис');
    setSetting('phone_main', str('phone_main'));
    setSetting('phone_main_tel', telNorm(str('phone_main_tel')));
    setSetting('phones_extra', [
      { title: str('e0_title'), display: str('e0_display'), tel: telNorm(str('e0_tel')) },
      { title: str('e1_title'), display: str('e1_display'), tel: telNorm(str('e1_tel')) },
    ]);
    setSetting('telegram_phone', str('telegram_phone'));
    setSetting('telegram_url', str('telegram_url'));
    setSetting('email', str('email'));
    setSetting('address', str('address'));
    setSetting('address_full', str('address_full'));
    setSetting('address_short', str('address_short'));
    setSetting('landmark', str('landmark'));
    setSetting('hours', str('hours'));
    setSetting('coords', { lat: num('lat', 47.193068), lon: num('lon', 39.648295) });
    setSetting('map_link', str('map_link'));
    setSetting('legal', { name: str('legal_name'), inn: str('legal_inn'), ogrnip: str('legal_ogrnip') });
    setSetting('ratings_visible', form.get('ratings_visible') === '1');
    setSetting('ratings', [0, 1, 2].map((i) => ({
      source: str(`r${i}_source`), value: str(`r${i}_value`), count: num(`r${i}_count`, 0),
      note: str(`r${i}_note`), url: str(`r${i}_url`),
    })).filter((r) => r.source || r.url || r.value || r.note));
    setSetting('slot_capacity', Math.max(1, Math.min(10, num('slot_capacity', 2))));
    const cv = str('consent_version');
    if (/^\d{4}-\d{2}-\d{2}$/.test(cv)) setSetting('consent_version', cv);
    setSetting('brands', str('brands').split('\n').map((b) => b.trim()).filter(Boolean).slice(0, 60));
  });
  tx();
  logAction(user.id, 'settings_save', 'settings', null, { keys: 'all' });
  return Astro.redirect('/admin/settings?msg=' + encodeURIComponent('Настройки сохранены'), 302);
}

const S = getSettings();
---
<Admin section="settings" title="Настройки">
  <h1 class="adm-h1">Настройки сайта</h1>
  <p class="hint u-mb18">Эти значения подставляются в шапку, футер, контакты, формы и JSON-LD. Telegram-бот и SMTP настраиваются только через переменные окружения сервера (секреты не хранятся в БД).</p>
  <form method="post" class="adm-form">
    <input type="hidden" name="_csrf" value={csrf}>
    <div class="adm-card">
      <h2>Основное</h2>
      <label>Название <input type="text" name="site_name" value={S.site_name} required></label>
      <div class="adm-row">
        <label>Часы работы <input type="text" name="hours" value={S.hours} required></label>
        <label>Вместимость слота (заявок в час) <input type="number" name="slot_capacity" value={S.slot_capacity} min="1" max="10"></label>
      </div>
    </div>
    <div class="adm-card">
      <h2>Контакты</h2>
      <div class="adm-row">
        <label>Основной телефон (показ) <input type="text" name="phone_main" value={S.phone_main} required></label>
        <label>Основной телефон (tel:) <input type="text" name="phone_main_tel" value={S.phone_main_tel} required pattern="\+?\d{11}"></label>
      </div>
      <div class="adm-row">
        <label>Доп. 1 — название <input type="text" name="e0_title" value={S.phones_extra[0]?.title ?? ''}></label>
        <label>Доп. 1 — показ <input type="text" name="e0_display" value={S.phones_extra[0]?.display ?? ''}></label>
        <label>Доп. 1 — tel <input type="text" name="e0_tel" value={S.phones_extra[0]?.tel ?? ''}></label>
      </div>
      <div class="adm-row">
        <label>Доп. 2 — название <input type="text" name="e1_title" value={S.phones_extra[1]?.title ?? ''}></label>
        <label>Доп. 2 — показ <input type="text" name="e1_display" value={S.phones_extra[1]?.display ?? ''}></label>
        <label>Доп. 2 — tel <input type="text" name="e1_tel" value={S.phones_extra[1]?.tel ?? ''}></label>
      </div>
      <div class="adm-row">
        <label>Telegram (номер) <input type="text" name="telegram_phone" value={S.telegram_phone}></label>
        <label>Telegram (ссылка) <input type="url" name="telegram_url" value={S.telegram_url}></label>
        <label>E-mail заявок <input type="email" name="email" value={S.email} required></label>
      </div>
    </div>
    <div class="adm-card">
      <h2>Адрес</h2>
      <label>Полный адрес <input type="text" name="address_full" value={S.address_full} required></label>
      <div class="adm-row">
        <label>Улица и дом <input type="text" name="address" value={S.address} required></label>
        <label>Коротко (для логотипа) <input type="text" name="address_short" value={S.address_short} required></label>
      </div>
      <label>Ориентир <input type="text" name="landmark" value={S.landmark}></label>
      <div class="adm-row">
        <label>Широта <input type="number" step="0.000001" name="lat" value={S.coords.lat}></label>
        <label>Долгота <input type="number" step="0.000001" name="lon" value={S.coords.lon}></label>
      </div>
      <label>Ссылка «Маршрут» (Яндекс Карты) <input type="url" name="map_link" value={S.map_link}></label>
    </div>
    <div class="adm-card">
      <h2>Юрлицо</h2>
      <label>Наименование <input type="text" name="legal_name" value={S.legal.name} required></label>
      <div class="adm-row">
        <label>ИНН <input type="text" name="legal_inn" value={S.legal.inn} pattern="\d{12}"></label>
        <label>ОГРНИП <input type="text" name="legal_ogrnip" value={S.legal.ogrnip} pattern="\d{15}"></label>
      </div>
      <p class="hint">Расчётный счёт и адрес регистрации не публикуются (решение из docs/01).</p>
    </div>
    <div class="adm-card">
      <h2>Рейтинги и марки</h2>
      <label class="adm-row"><input type="checkbox" name="ratings_visible" value="1" checked={S.ratings_visible}> показывать блок рейтингов на сайте</label>
      <p class="hint">Не включайте, пока владелец не подтвердил цифры: оценки публикуются только с источником и датой.</p>
      {[0, 1, 2].map((i) => {
        // Всегда три строки, даже если ratings пуст (B1 ревью): иначе очистив источники,
        // владелец не мог бы вернуть рейтинги через админку — только правкой БД.
        const r = S.ratings[i] ?? { source: '', value: '', count: 0, note: '', url: '' };
        return (
          <div class="adm-row u-mt14">
            <label>Источник <input type="text" name={`r${i}_source`} value={r.source}></label>
            <label>Оценка <input type="text" name={`r${i}_value`} value={r.value}></label>
            <label>Кол-во <input type="number" name={`r${i}_count`} value={r.count} min="0"></label>
            <label>Примечание <input type="text" name={`r${i}_note`} value={r.note}></label>
            <label>Ссылка <input type="url" name={`r${i}_url`} value={r.url}></label>
          </div>
        );
      })}
      <label>Марки (по одной в строке — бегущая строка на главной и подсказки в форме)
        <textarea name="brands" rows="8">{S.brands.join('\n')}</textarea>
      </label>
    </div>
    <div class="adm-card">
      <h2>Согласие на обработку ПД</h2>
      <label>Версия политики (ГГГГ-ММ-ДД)
        <input type="text" name="consent_version" value={S.consent_version} pattern="\d{4}-\d{2}-\d{2}">
      </label>
      <p class="hint">При смене версии формы начнут фиксировать новую; старые заявки сохранят прежнюю.</p>
    </div>
    <button type="submit" class="btn btn--copper">Сохранить настройки</button>
  </form>
</Admin>
