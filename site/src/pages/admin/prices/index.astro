---
/**
 * Круг 85, задание 85-2 (Агент 11): раздел «Цены и услуги».
 *
 * Одна страница: все цены сайта по категориям, поле «Новая цена» в каждой строке,
 * «Сохранить» на категорию и «Сохранить всё» на липкой панели. Обычная форма POST +
 * серверный рендер, без фреймворка — как /admin/services.
 *
 * Что здесь важно и почему:
 *  - Источник правды один: `content/prices.json`. В SQLite цены не пишутся (там только
 *    журнал действий) — иначе сайт и админка молча разъедутся.
 *  - Перед записью файл перечитывается, правки применяются к свежей версии, запись
 *    атомарная (tmp → rename). См. `prices-admin-store.ts`.
 *  - Скрытие — пометка `hidden: true`, а не удаление: строку видно в разделе «Скрытые
 *    строки», оттуда её можно вернуть.
 *  - Нигде не обещано, что сайт обновится сам: он на GitHub Pages, публикация отдельная.
 *  - Вложенных <form> нет: кнопка «Скрыть» лежит внутри формы сохранения, но отправляет
 *    СВОЮ форму через атрибут form="…" — так строка скрывается одним нажатием, не
 *    отправляя и не теряя недописанные цены.
 */
import Admin from '../../../layouts/Admin.astro';
import { sessionFromContext, csrfValidForm, csrfRefusal, logAction, ensureCsrfCookie } from '../../../server/admin-auth.ts';
import {
  readPrices, applyChanges, categories, allIds, uniqueId, slugifyRu,
  checkPrice, checkName, dateRu, CATEGORY_LABEL, PricesError,
  type CategoryKey, type RowPatch, type Prices,
} from '../../../server/prices-admin-store.ts';

const user = sessionFromContext(Astro)!;
const csrf = ensureCsrfCookie(Astro);

type Action = 'save' | 'add' | 'hide' | 'restore' | 'saveAll';

/** 1 позиция / 2 позиции / 5 позиций. */
function plural(n: number, one: string, few: string, many: string): string {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
}

const back = (q: string): Response => Astro.redirect('/admin/prices?' + q, 302);
const fail = (message: string, cat?: string): Response =>
  back('err=' + encodeURIComponent(message) + (cat ? '&cat=' + encodeURIComponent(cat) : ''));

type Row = { id: string } & Record<string, unknown>;

function rowsOf(p: Prices, cat: CategoryKey): Row[] {
  if (cat.startsWith('group:')) {
    const g = p.groups.find((x) => x.id === cat.slice('group:'.length));
    return (g?.items ?? []) as unknown as Row[];
  }
  if (cat === 'tyres:set') return p.tyres.set as unknown as Row[];
  if (cat === 'tyres:repair') return p.tyres.repair as unknown as Row[];
  if (cat === 'tyres:extra') return p.tyres.extra as unknown as Row[];
  if (cat === 'voyah') return p.voyah as unknown as Row[];
  return [];
}

/**
 * Сохраняет изменённые строки одной или нескольких категорий.
 *
 * Изменённой считается строка, где поле заполнено и НЕ совпадает с текущей ценой: так
 * мастер может нажать «Сохранить», ничего не трогая, и дата «Цифры подтверждены …» на
 * прайсе не сдвинется от пустого нажатия.
 */
function saveCategories(form: FormData, cats: CategoryKey[], opts: { quiet?: boolean } = {}): Response | null {
  let p: Prices;
  try { p = readPrices(); } catch (e) {
    return fail(e instanceof PricesError ? e.message : 'Не удалось прочитать цены');
  }
  let totalChanged = 0;
  const rowErrors: string[] = [];

  for (const cat of cats) {
    const patches: Record<string, RowPatch> = {};
    for (const row of rowsOf(p, cat)) {
      if (cat === 'tyres:set') {
        const passenger = String(form.get(`tyre:${row.id}:passenger`) ?? '').trim();
        const crossover = String(form.get(`tyre:${row.id}:crossover`) ?? '').trim();
        const now = row as { passenger: string; crossover: string; radius: string };
        const next: NonNullable<RowPatch['tyre']> = {};
        if (passenger && passenger !== now.passenger) {
          const e = checkPrice(passenger);
          if (e) rowErrors.push(`${now.radius} (легковые): ${e}`); else next.passenger = passenger;
        }
        if (crossover && crossover !== now.crossover) {
          const e = checkPrice(crossover);
          if (e) rowErrors.push(`${now.radius} (кроссовер): ${e}`); else next.crossover = crossover;
        }
        if (Object.keys(next).length) patches[row.id] = { tyre: next };
      } else {
        const value = String(form.get(`price:${row.id}`) ?? '').trim();
        const current = String((row as { price?: string }).price ?? '');
        if (!value || value === current) continue;
        const e = checkPrice(value);
        const label = String((row as { name?: string; range?: string }).name ?? (row as { range?: string }).range ?? row.id);
        if (e) rowErrors.push(`${label}: ${e}`);
        else patches[row.id] = { price: value };
      }
    }
    if (!Object.keys(patches).length) continue;
    try {
      const res = applyChanges(cat, patches);
      if (res.changed > 0) {
        totalChanged += res.changed;
        /* Журнал: одна запись на сохранённую категорию. В /admin/log видно, какая
           категория и сколько строк изменили, — а не одна запись на весь прайс. */
        logAction(user.id, 'prices_save', 'prices', cat, { changed: res.changed });
      }
    } catch (e) {
      return fail(e instanceof PricesError ? e.message : 'Не удалось записать цены — попробуйте ещё раз', cat);
    }
  }

  if (rowErrors.length) return fail(rowErrors.join('; '), cats[0]);
  if (opts.quiet) return null;   /* вызывающий сам скажет, что произошло */
  if (!totalChanged) return back('msg=' + encodeURIComponent('Изменений нет — всё уже сохранено'));
  const when = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
  return back('msg=' + encodeURIComponent(`Сохранено в ${when}: изменено ${totalChanged} ${plural(totalChanged, 'позиция', 'позиции', 'позиций')}`));
}

async function handlePost(form: FormData): Promise<Response> {
  const action = String(form.get('action') ?? '') as Action;
  const cat = String(form.get('cat') ?? '') as CategoryKey;
  const str = (k: string): string => String(form.get(k) ?? '').trim();

  if (action === 'saveAll') {
    /* Только те категории, где мастер реально что-то поправил: скрипт кладёт их в
       catAll. Если категорий нет — сохранять нечего, и это не ошибка. */
    const cats = form.getAll('catAll').map((v) => String(v)) as CategoryKey[];
    if (!cats.length) return back('msg=' + encodeURIComponent('Изменений нет — всё уже сохранено'));
    return saveCategories(form, cats);
  }
  if (action === 'add') {
    const name = str('newName'), price = str('newPrice');
    const nameErr = checkName(name);
    if (nameErr) return fail(nameErr, cat);
    const priceErr = checkPrice(price);
    if (priceErr) return fail(priceErr, cat);
    try {
      const p = readPrices();
      const id = uniqueId(slugifyRu(name), allIds(p));
      const res = applyChanges(cat, { [id]: { add: { id, name }, price } });
      logAction(user.id, 'prices_save', 'prices', cat, { added: res.added, name });
    } catch (e) {
      return fail(e instanceof PricesError ? e.message : 'Не удалось добавить строку — попробуйте ещё раз', cat);
    }
    return back('msg=' + encodeURIComponent(`«${name}» добавлено в конец категории`) + '&cat=' + encodeURIComponent(cat));
  }

  /* Скрытие приходит из формы сохранения (кнопка name="hideRow"): мастер мог поправить
     цены в этой же категории, и терять их нельзя. Поэтому сначала сохраняем правки, потом
     скрываем строку — одним действием и одним сообщением. */
  const hideRow = str('hideRow');
  if (hideRow) {
    const saved = saveCategories(form, [cat], { quiet: true });
    if (saved) return saved;   /* ошибка цен: скрывать нечего, показываем её */
    try {
      applyChanges(cat, { [hideRow]: { hidden: true } });
      logAction(user.id, 'prices_save', 'prices', cat, { hidden: 1, row: hideRow });
    } catch (e) {
      return fail(e instanceof PricesError ? e.message : 'Не удалось скрыть строку — попробуйте ещё раз', cat);
    }
    return back('msg=' + encodeURIComponent('Строка скрыта — на прайсе её больше нет. Вернуть можно в разделе «Скрытые строки».') + '&cat=' + encodeURIComponent(cat));
  }

  if (action === 'save') {
    if (!cat) return fail('Не понял, какую категорию сохранять — обновите страницу');
    return saveCategories(form, [cat]);
  }

  if (action === 'hide' || action === 'restore') {
    const id = str('rowId');
    if (!id) return fail('Не понял, какую строку менять — обновите страницу', cat);
    try {
      const res = applyChanges(cat, { [id]: { hidden: action === 'hide' } });
      logAction(user.id, 'prices_save', 'prices', cat, { hidden: action === 'hide' ? 1 : 0, row: id });
      if (action === 'restore' && res.changed === 0) {
        return back('msg=' + encodeURIComponent('Эта строка уже видна на прайсе') + '&cat=' + encodeURIComponent(cat));
      }
      return back('msg=' + encodeURIComponent(action === 'hide' ? 'Строка скрыта — на прайсе её больше нет' : 'Строка снова видна на прайсе') + '&cat=' + encodeURIComponent(cat));
    } catch (e) {
      return fail(e instanceof PricesError ? e.message : 'Не удалось сохранить — попробуйте ещё раз', cat);
    }
  }

  return fail('Неизвестное действие — обновите страницу и повторите');
}

if (Astro.request.method === 'POST') {
  /* Тело читается ровно один раз: formData() на одном запросе вызывается единожды,
     а поля нужны и проверке CSRF, и сохранению. */
  const form = await Astro.request.formData().catch(() => null);
  if (!form || !(await csrfValidForm(Astro, form))) return csrfRefusal(Astro);
  return await handlePost(form);
}

/* ---------- чтение для экрана ---------- */

let prices: Prices | null = null;
let readError = '';
try {
  prices = readPrices();
} catch (e) {
  readError = e instanceof PricesError ? e.message : 'Не удалось прочитать цены';
}

const P = prices;
const cats = prices ? categories(prices) : [];
const hiddenGroups = prices ? prices.groups.flatMap((g) => g.items.filter((i) => i.hidden).map((i) => ({ id: i.id, name: i.name, where: g.title, cat: `group:${g.id}` as CategoryKey }))) : [];
const hiddenExtra = prices ? prices.tyres.extra.filter((i) => i.hidden).map((i) => ({ id: i.id, name: i.name, where: CATEGORY_LABEL['tyres:extra'], cat: 'tyres:extra' as CategoryKey })) : [];
const hiddenRows = [...hiddenGroups, ...hiddenExtra];
const lastSaved = prices ? dateRu(prices.updated_at) : '';
---

<Admin section="prices" title="Цены и услуги">
  <h1 class="adm-h1">Цены и услуги</h1>
  <p class="hint u-mb18">
    Здесь меняются цены на сайте. После сохранения цифры обновятся на всех страницах:
    в прайсе, на карточках услуг и на главной.
  </p>

  {readError && <div class="adm-msg adm-msg--err" role="alert">{readError} Цены не изменялись — сообщите разработчику.</div>}

  {P && (
    <>
      <!-- Липкая панель: видна, пока мастер листает длинный прайс. -->
      <div class="pr-bar">
        <div class="pr-bar-info">
          <span class="pr-bar-n"><b data-pr-count>0</b> <span data-pr-count-word>изменений</span></span>
          <span class="pr-bar-date">Цены подтверждены {lastSaved}</span>
        </div>
        <div class="pr-bar-actions">
          <button type="submit" form="pr-all" class="btn btn--copper" data-pr-save-all>Сохранить всё</button>
          <a href="/admin/prices" class="btn btn--ghost">Отменить изменения</a>
          <a href="/admin/prices/export" class="btn btn--ghost">Скачать файл цен</a>
        </div>
      </div>

      <!-- «Сохранить всё» — отдельная форма; кнопка на панели связана с ней через form="pr-all".
           Поля всех категорий лежат в своих формах, поэтому для «сохранить всё» форма
           собирает только список категорий, а сами значения сервер читает из полей,
           которые браузер отправляет вместе с нажатой кнопкой… — но кнопка вне форм,
           поэтому значения передаёт скрипт ниже. Без скрипта кнопка скрыта: честнее
           показать «Сохранить» в каждой категории, чем молча потерять правки. -->
      <form method="post" id="pr-all" class="pr-all-form" data-pr-all-form>
        <input type="hidden" name="_csrf" value={csrf}>
        <input type="hidden" name="action" value="saveAll">

        <div data-pr-all-fields></div>
      </form>

      <details class="adm-card pr-how" open>
        <summary><b>Как изменения попадут на сайт</b></summary>
        <p>
          Изменения сохраняются в файле цен. На опубликованном сайте они появятся после публикации —
          её делает разработчик или раздел «Цены» на странице
          <a href="/manage/" target="_blank" rel="noopener">/manage/</a>.
        </p>
        <p>
          Если вы меняете цены здесь, скажите об этом — мы опубликуем. Быстрее всего — раздел «Цены»
          на странице <a href="/manage/" target="_blank" rel="noopener">/manage/</a>.
          Кнопка «Скачать файл цен» отдаёт текущие цены: их можно передать, не заходя на сервер.
        </p>
      </details>

      <!-- 1. Группы прайса -->
      <h2 class="pr-h2">Прайс на странице «Прайс»</h2>
      {P.groups.map((g) => {
        const visible = g.items.filter((i) => !i.hidden);
        const hiddenN = g.items.length - visible.length;
        return (
          <details class="adm-card pr-cat" open data-cat={`group:${g.id}`}>
            <summary>
              <span class="pr-cat-title">{g.title}</span>
              <span class="pr-cat-meta">позиций: {visible.length}{hiddenN ? ` · скрыто: ${hiddenN}` : ''}</span>
              <span class="pr-cat-chg" data-chg hidden></span>
            </summary>

            <form method="post" class="pr-save">
              <input type="hidden" name="_csrf" value={csrf}>
              <input type="hidden" name="action" value="save">
              <input type="hidden" name="cat" value={`group:${g.id}`}>

              <table class="pr-table">
                <thead><tr><th>Работа</th><th>Сейчас</th><th>Новая цена</th><th><span class="pr-vh">Скрыть</span></th></tr></thead>
                <tbody>
                  {visible.map((it) => (
                    <tr>
                      <td class="pr-name" data-l="Работа">{it.name}</td>
                      <td class="pr-now" data-l="Сейчас">{it.price}</td>
                      <td class="pr-new" data-l="Новая цена">
                        <label class="pr-lbl" for={`price:${it.id}`}>Новая цена: {it.name}</label>
                        <input type="text" id={`price:${it.id}`} name={`price:${it.id}`} placeholder={it.price}
                               inputmode="text" autocomplete="off" data-pr-input data-now={it.price}>
                      </td>
                      <td class="pr-hide">
                        <button type="submit" name="hideRow" value={it.id} class="pr-hide-btn"
                                data-confirm={`Скрыть «${it.name.replace(/"/g, '”')}»? Строка исчезнет со страницы прайса, но останется в разделе «Скрытые строки».`}>
                          Скрыть
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <div class="pr-actions">
                <button type="submit" class="btn btn--copper">Сохранить</button>
                <span class="pr-hint">Пишите как для клиента: 1200 ₽, от 1500 ₽, 2200–4000 ₽</span>
              </div>
            </form>

            <form method="post" class="pr-add">
              <input type="hidden" name="_csrf" value={csrf}>
              <input type="hidden" name="action" value="add">
              <input type="hidden" name="cat" value={`group:${g.id}`}>
              <label>Название работы
                <input type="text" name="newName" placeholder="Например: Развал-схождение" maxlength="120" minlength="2" required>
              </label>
              <label>Цена
                <input type="text" name="newPrice" placeholder="1500 ₽" maxlength="40" required>
              </label>
              <button type="submit" class="btn btn--ghost">Добавить в категорию</button>
            </form>
            <p class="hint">Новая строка встанет в конец категории «{g.title}».</p>
          </details>
        );
      })}

      <!-- 2. Шины и колёса -->
      <h2 class="pr-h2">Шины и колёса</h2>

      <details class="adm-card pr-cat" open data-cat="tyres:set">
        <summary>
          <span class="pr-cat-title">Шиномонтаж комплекта</span>
          <span class="pr-cat-meta">позиций: {P.tyres.set.length}</span>
          <span class="pr-cat-chg" data-chg hidden></span>
        </summary>
        <form method="post" class="pr-save">
          <input type="hidden" name="_csrf" value={csrf}>
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="cat" value="tyres:set">
          <p class="hint">Цена за комплект из четырёх колёс.</p>
          <table class="pr-table pr-table--tyres">
            <thead>
              <tr>
                <th>Радиус</th>
                <th>Легковые, сейчас</th><th>Легковые, новая</th>
                <th>Кроссовер, сейчас</th><th>Кроссовер, новая</th>
              </tr>
            </thead>
            <tbody>
              {P.tyres.set.map((r) => (
                <tr>
                  <td class="pr-name" data-l="Радиус">{r.radius}</td>
                  <td class="pr-now" data-l="Легковые, сейчас">{r.passenger}</td>
                  <td class="pr-new" data-l="Легковые, новая">
                    <label class="pr-lbl" for={`tyre:${r.id}:passenger`}>Новая цена для легковых, {r.radius}</label>
                    <input type="text" id={`tyre:${r.id}:passenger`} name={`tyre:${r.id}:passenger`} placeholder={r.passenger}
                           autocomplete="off" data-pr-input data-now={r.passenger}>
                  </td>
                  <td class="pr-now" data-l="Кроссовер, сейчас">{r.crossover}</td>
                  <td class="pr-new" data-l="Кроссовер, новая">
                    <label class="pr-lbl" for={`tyre:${r.id}:crossover`}>Новая цена для кроссоверов, {r.radius}</label>
                    <input type="text" id={`tyre:${r.id}:crossover`} name={`tyre:${r.id}:crossover`} placeholder={r.crossover}
                           autocomplete="off" data-pr-input data-now={r.crossover}>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="pr-actions">
            <button type="submit" class="btn btn--copper">Сохранить</button>
            <span class="pr-hint">Пишите как для клиента: 2200 ₽</span>
          </div>
        </form>
      </details>

      <details class="adm-card pr-cat" open data-cat="tyres:repair">
        <summary>
          <span class="pr-cat-title">Ремонт колёс</span>
          <span class="pr-cat-meta">позиций: {P.tyres.repair.length}</span>
          <span class="pr-cat-chg" data-chg hidden></span>
        </summary>
        <form method="post" class="pr-save">
          <input type="hidden" name="_csrf" value={csrf}>
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="cat" value="tyres:repair">
          <p class="hint">Цена за одно колесо.</p>
          <table class="pr-table">
            <thead><tr><th>Радиус</th><th>Сейчас</th><th>Новая цена</th></tr></thead>
            <tbody>
              {P.tyres.repair.map((r) => (
                <tr>
                  <td class="pr-name" data-l="Радиус">{r.range}</td>
                  <td class="pr-now" data-l="Сейчас">{r.price}</td>
                  <td class="pr-new" data-l="Новая цена">
                    <label class="pr-lbl" for={`price:${r.id}`}>Новая цена, {r.range}</label>
                    <input type="text" id={`price:${r.id}`} name={`price:${r.id}`} placeholder={r.price}
                           autocomplete="off" data-pr-input data-now={r.price}>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="pr-actions"><button type="submit" class="btn btn--copper">Сохранить</button></div>
        </form>
      </details>

      <details class="adm-card pr-cat" open data-cat="tyres:extra">
        <summary>
          <span class="pr-cat-title">Колёса и балансировка</span>
          <span class="pr-cat-meta">позиций: {P.tyres.extra.filter((i) => !i.hidden).length}</span>
          <span class="pr-cat-chg" data-chg hidden></span>
        </summary>
        <form method="post" class="pr-save">
          <input type="hidden" name="_csrf" value={csrf}>
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="cat" value="tyres:extra">
          <table class="pr-table">
            <thead><tr><th>Работа</th><th>Сейчас</th><th>Новая цена</th><th><span class="pr-vh">Скрыть</span></th></tr></thead>
            <tbody>
              {P.tyres.extra.filter((i) => !i.hidden).map((it) => (
                <tr>
                  <td class="pr-name" data-l="Работа">{it.name}</td>
                  <td class="pr-now" data-l="Сейчас">{it.price}</td>
                  <td class="pr-new" data-l="Новая цена">
                    <label class="pr-lbl" for={`price:${it.id}`}>Новая цена: {it.name}</label>
                    <input type="text" id={`price:${it.id}`} name={`price:${it.id}`} placeholder={it.price}
                           autocomplete="off" data-pr-input data-now={it.price}>
                  </td>
                  <td class="pr-hide">
                    <button type="submit" name="hideRow" value={it.id} class="pr-hide-btn"
                            data-confirm={`Скрыть «${it.name.replace(/"/g, '”')}»? Строка исчезнет со страницы прайса, но останется в разделе «Скрытые строки».`}>
                      Скрыть
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="pr-actions"><button type="submit" class="btn btn--copper">Сохранить</button></div>
        </form>
      </details>

      <!-- 3. Voyah Free -->
      <h2 class="pr-h2">Voyah Free</h2>
      <details class="adm-card pr-cat" open data-cat="voyah">
        <summary>
          <span class="pr-cat-title">Прайс Voyah Free</span>
          <span class="pr-cat-meta">позиций: {P.voyah.length}</span>
          <span class="pr-cat-chg" data-chg hidden></span>
        </summary>
        <form method="post" class="pr-save">
          <input type="hidden" name="_csrf" value={csrf}>
          <input type="hidden" name="action" value="save">
          <input type="hidden" name="cat" value="voyah">
          <table class="pr-table">
            <thead><tr><th>Работа</th><th>Пояснение</th><th>Сейчас</th><th>Новая цена</th></tr></thead>
            <tbody>
              {P.voyah.map((v) => (
                <tr>
                  <td class="pr-name" data-l="Работа">{v.name}</td>
                  <td class="pr-note" data-l="Пояснение">{v.note || '—'}</td>
                  <td class="pr-now" data-l="Сейчас">{v.price}</td>
                  <td class="pr-new" data-l="Новая цена">
                    <label class="pr-lbl" for={`price:${v.id}`}>Новая цена: {v.name}</label>
                    <input type="text" id={`price:${v.id}`} name={`price:${v.id}`} placeholder={v.price}
                           autocomplete="off" data-pr-input data-now={v.price}>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="pr-actions">
            <button type="submit" class="btn btn--copper">Сохранить</button>
            <span class="pr-hint">Пояснение меняется на странице Voyah Free — здесь только цена</span>
          </div>
        </form>
      </details>

      <!-- 4. Плашки на главной: цена берётся из позиции Voyah -->
      <h2 class="pr-h2">Плашки на главной</h2>
      <details class="adm-card pr-cat" data-cat="featured">
        <summary>
          <span class="pr-cat-title">Три плашки с ценой</span>
          <span class="pr-cat-meta">плашек: {P.featured.length}</span>
        </summary>
        <table class="pr-table">
          <thead><tr><th>Плашка</th><th>Пояснение</th><th>Цена</th></tr></thead>
          <tbody>
            {P.featured.map((f) => {
              const src = P.voyah.find((v) => v.id === f.ref);
              return (
                <tr>
                  <td class="pr-name" data-l="Плашка">{f.title}</td>
                  <td class="pr-note" data-l="Пояснение">{f.note || '—'}</td>
                  <td class="pr-now" data-l="Цена">
                    {src ? `${src.price} — цена берётся из позиции «${src.name}»` : 'позиция не найдена'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="hint">
          Цену плашки здесь не пишут: она та же, что у позиции прайса Voyah.
          Поменяйте цену выше — плашка изменится вместе с ней.
        </p>
      </details>

      <!-- Скрытые строки: убранное с прайса. Отсюда можно вернуть. -->
      <h2 class="pr-h2">Скрытые строки {hiddenRows.length ? `(${hiddenRows.length})` : ''}</h2>
      <details class="adm-card pr-cat" open={hiddenRows.length > 0}>
        <summary>
          <span class="pr-cat-title">Убранные с прайса</span>
          <span class="pr-cat-meta">{hiddenRows.length ? `скрыто: ${hiddenRows.length}` : 'пусто'}</span>
        </summary>
        {hiddenRows.length === 0 ? (
          <p class="adm-empty">
            Скрытых строк нет. Когда вы скроете строку, она появится здесь — и её можно будет вернуть.
          </p>
        ) : (
          <table class="pr-table">
            <thead><tr><th>Работа</th><th>Категория</th><th></th></tr></thead>
            <tbody>
              {hiddenRows.map((h) => (
                <tr>
                  <td class="pr-name" data-l="Работа">{h.name}</td>
                  <td class="pr-note" data-l="Категория">{h.where}</td>
                  <td>
                    <form method="post" class="pr-inline">
                      <input type="hidden" name="_csrf" value={csrf}>
                      <input type="hidden" name="action" value="restore">
                      <input type="hidden" name="cat" value={h.cat}>
                      <input type="hidden" name="rowId" value={h.id}>
                      <button type="submit" class="btn btn--ghost">Вернуть на прайс</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </details>

      <!-- Счётчик изменений и сборка полей для «Сохранить всё» — отдельным файлом
           (/js/admin-prices.js): политика безопасности сайта запрещает встроенные
           скрипты, и ослаблять её ради счётчика нельзя. Путь без «admin» — экспортёр
           копирует static целиком, а гейт публикации не пускает каталог admin на Pages. -->
      <script src="/js/admin-prices.js" defer></script>
    </>
  )}

  {!P && <p class="adm-empty">Цены не прочитаны. Обновите страницу; если не поможет — сообщите разработчику.</p>}
</Admin>

