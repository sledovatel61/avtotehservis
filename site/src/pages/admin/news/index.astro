---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../server/db.ts';
import { fmtDateShort } from '../../../server/format.ts';
import { catTitle } from '../../../server/content.ts';

const items = db().prepare('SELECT * FROM news ORDER BY published_at DESC NULLS LAST, id DESC').all() as {
  id: number; slug: string; title: string; category: string; status: string; published_at: string | null; excerpt: string | null;
}[];
---
<Admin section="news" title="Новости">
  <div class="adm-row u-mb18">
    <h1 class="adm-h1 u-mb0">Новости и акции</h1>
    <a class="btn btn--copper" href="/admin/news/new">＋ Новая статья</a>
  </div>
  {items.length ? (
    <div class="adm-card">
      <table class="adm-table">
        <thead><tr><th>Заголовок</th><th>Категория</th><th>Дата</th><th>Статус</th><th></th></tr></thead>
        <tbody>
          {items.map((n) => (
            <tr>
              <td><a href={`/admin/news/${n.id}`}><b>{n.title}</b></a><div class="hint">/{n.slug}</div></td>
              <td>{catTitle(n.category)}</td>
              <td>{n.published_at ? fmtDateShort(n.published_at) : '—'}</td>
              <td><span class={`badge badge--${n.status}`}>{n.status === 'published' ? 'опубликована' : 'черновик'}</span></td>
              <td><a href={`/admin/news/${n.id}`}>править →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : <p class="adm-empty">Статей пока нет — на сайте показывается честное пустое состояние «Публикуем новости по мере поступления».</p>}
</Admin>
