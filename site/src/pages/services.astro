---
import Base from '../layouts/Base.astro';
import { getSettings } from '../server/settings.ts';
import { listCatalogServices } from '../server/services.ts';
import { fmtDateRu, plural } from '../server/format.ts';
import { svcImgKey } from '../server/svc-img.ts';

const S = getSettings();
const services = listCatalogServices();
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Услуги' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: services.map((sv, i) => ({
      '@type': 'ListItem', position: i + 1, name: sv.title, url: siteUrl + '/services/' + sv.slug,
    })),
  },
];
---
<Base
  page="services"
  title="Услуги автосервиса на Портовой, 439 — цены"
  description="Восемь направлений: шины, ТО, тормоза, подвеска, ГРМ и сцепление, сварочные работы, диагностика и автокондиционеры. У каждой услуги — цена «от» по прайсу сервиса."
  jsonLd={jsonLd}
>

<nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">Услуги</span></nav>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Услуги</span>
    <h1>Услуги и цены: что делаем на Портовой, 439</h1>
    <p class="lead">Восемь направлений: шины, ТО, тормоза, подвеска, ГРМ и сцепление, сварочные работы, диагностика и автокондиционеры. У каждой услуги — цена «от» по прайсу сервиса; точную сумму называем после осмотра, до начала работ.</p>
  </div>
</section>
<section class="sec" aria-labelledby="sv-grid-h">
  <div class="container">
    <h2 id="sv-grid-h" class="u-sr">Каталог услуг</h2>
    <div class="svc-grid">
          {services.map((sv) => (
            <a class="svc-card" href={`/services/${sv.slug}`}>
              <span class="svc-img">
                <picture>
                  <source type="image/avif" srcset={`/img/${svcImgKey(sv.slug)}-640.avif 640w, /img/${svcImgKey(sv.slug)}-960.avif 960w`} sizes="(max-width:640px) 84vw, (max-width:1024px) 44vw, 380px">
                  <source type="image/webp" srcset={`/img/${svcImgKey(sv.slug)}-640.webp 640w, /img/${svcImgKey(sv.slug)}-960.webp 960w`} sizes="(max-width:640px) 84vw, (max-width:1024px) 44vw, 380px">
                  <img src={`/img/${svcImgKey(sv.slug)}-640.webp`} alt={sv.title} width="800" height="600" loading="lazy" decoding="async">
                </picture>
              </span>
              <span class="svc-body"><span class="svc-tag">{sv.tag ?? sv.grp}</span><h3>{sv.title}</h3><p>{sv.short}</p>{sv.price_from ? <span class="svc-price">{sv.price_from}</span> : null}<span class="link-more">Подробнее <span class="ar" aria-hidden="true">→</span></span></span>
            </a>
          ))}
      </div>
    <p class="svc-grid-note">Цены — за работу, без запчастей и расходников; диапазон означает разную сложность и крепление на разных машинах. Точную сумму называем до начала работ. Чего-то не нашли в списке? Позвоните — {S.phone_main}.</p>
    <p class="u-chips-mt26">
      <a class="btn btn--copper" href="/appointment">Записаться на визит</a>
      <a class="btn btn--ghost" href={`tel:${S.phone_main_tel}`} data-track="call_click">Позвонить: {S.phone_main}</a>
    </p>
  </div>
</section>

</Base>
