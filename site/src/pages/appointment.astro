---
import Base from '../layouts/Base.astro';
import { getSettings, getSetting } from '../server/settings.ts';
import { listChipServices } from '../server/services.ts';

const S = getSettings();
const chipLabels = getSetting<Record<string, string>>('chip_labels', {});
const chipGroups: { name: string; items: { slug: string; label: string }[] }[] = [];
for (const sv of listChipServices()) {
  const gname = sv.grp ?? 'Прочее';
  let g = chipGroups.find((x) => x.name === gname);
  if (!g) { g = { name: gname, items: [] }; chipGroups.push(g); }
  g.items.push({ slug: sv.slug, label: chipLabels[sv.slug] ?? sv.title });
}
const preselect = Astro.url.searchParams.get('s') ?? '';
---
<Base
  page="appointment"
  title="Запись на сервис — АвтоТехСервис, Ростов-на-Дону"
  description="Онлайн-запись в автосервис на Портовой, 439: пять шагов, марка и VIN, услуги, удобные дата и время 9:00–19:00. Стоимость — после осмотра, смета до начала работ."
>

<nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">Запись</span></nav>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Запись</span>
    <h1>Запись на визит</h1>
    <p class="lead">Пять коротких шагов: автомобиль — услуги — дата и время — контакты — проверка. Займёт пару минут, а к вашему приезду бокс и мастер будут готовы. Не хочется заполнять? Позвоните: <a href={`tel:${S.phone_main_tel}`} data-track="call_click" class="u-brass"><b>{S.phone_main}</b></a>.</p>
  </div>
</section>
<section class="sec" aria-labelledby="appt-h">
  <h2 id="appt-h" class="u-sr">Форма записи</h2>
  <div class="container contacts-grid">
    <div>
      <p class="hint u-note-box" id="draft-note">
        <b class="u-brass">Черновик восстановлен</b> — введённые данные сохраняются в этом браузере и переживают перезагрузку страницы.
        <button type="button" class="skip-chip u-mla" id="clear-draft">Очистить черновик</button>
      </p>
      <span id="brands-data" hidden>{JSON.stringify(S.brands)}</span>
      <form class="wiz" id="wiz" novalidate aria-labelledby="wiz-step-label" data-preselect={preselect} data-consent-version={S.consent_version}>
        <div class="wiz-top">
          <div class="wiz-prog-row">
            <span class="wiz-step-label" id="wiz-step-label">Шаг 1 из 5 — Автомобиль</span>
            <span class="wiz-count" id="wiz-count">1 / 5</span>
          </div>
          <div class="wiz-bar"><i id="wiz-bar"></i></div>
        </div>
        <div id="wiz-steps">
          <div class="wiz-body">

            <div class="step is-on" data-step="1">
              <h2>Автомобиль</h2>
              <p class="step-desc">Марка — обязательна: по ней подберём расходники и проверим, есть ли у нас нужный размер. Год, VIN и пробег — по желанию: они помогают точнее оценить работы, но не спрашиваются «для галочки».</p>
              <div class="fields">
                <div class="field">
                  <label for="f-brand">Марка <span class="req" aria-hidden="true">*</span></label>
                  <div class="combo">
                    <input class="input" type="text" id="f-brand" name="brand" autocomplete="off" placeholder="Начните вводить: Лада, Toyota…" role="combobox" aria-expanded="false" aria-controls="brand-sugg" aria-describedby="brand-hint">
                    <div class="sugg" id="brand-sugg" role="listbox" aria-label="Варианты марок"></div>
                  </div>
                  <span class="hint" id="brand-hint">В списке 20 популярных марок. Вашей нет? Впишите прямо в поле — обслуживаем любые автомобили.</span>
                  <span class="err" role="alert"></span>
                </div>
                <div class="field">
                  <label for="f-model">Модель <span class="opt">необязательно</span></label>
                  <input class="input" type="text" id="f-model" name="model" autocomplete="off" placeholder="Например: Vesta, Camry">
                </div>
                <div class="field">
                  <label for="f-year">Год выпуска <span class="opt">необязательно</span></label>
                  <input class="input" type="text" inputmode="numeric" id="f-year" name="year" maxlength="4" placeholder="Например: 2019" aria-describedby="year-hint">
                  <span class="hint" id="year-hint">Число от 1980 до 2026</span>
                  <span class="err" role="alert"></span>
                  <button type="button" class="skip-chip" id="skip-year" aria-pressed="false">Не помню год</button>
                </div>
                <div class="field">
                  <label for="f-vin">VIN <span class="opt">необязательно</span></label>
                  <input class="input" type="text" id="f-vin" name="vin" data-vin maxlength="17" placeholder="17 символов" autocomplete="off" aria-describedby="vin-hint">
                  <span class="hint" id="vin-hint">17 символов · буквы I, O, Q в VIN не используются</span>
                  <span class="err" role="alert"></span>
                  <button type="button" class="skip-chip" id="skip-vin" aria-pressed="false">Не знаю VIN</button>
                </div>
                <div class="field">
                  <label for="f-mileage">Пробег, км <span class="opt">необязательно</span></label>
                  <input class="input" type="text" inputmode="numeric" id="f-mileage" name="mileage" maxlength="7" placeholder="Например: 84000" aria-describedby="mil-hint">
                  <span class="hint" id="mil-hint">Число километров — помогает понять ресурс расходников</span>
                  <span class="err" role="alert"></span>
                  <button type="button" class="skip-chip" id="skip-mileage" aria-pressed="false">Не знаю пробег</button>
                </div>
              </div>
            </div>

            <div class="step" data-step="2" aria-hidden="true">
              <h2>Что нужно сделать</h2>
              <p class="step-desc">Отметьте одну или несколько услуг — значения передаются на сервер явными кодами, а не текстом галочек. Не уверены в причине? Так и отметьте: «Не знаю — нужна диагностика».</p>
              <div class="chip-groups" id="svc-chips">
              {chipGroups.map((g) => (
                <div class="chip-group">
                  <h3>{g.name}</h3>
                  <div class="chips">
                    {g.items.map((it) => (
                      <label class="chip"><input type="checkbox" name="svc" value={it.slug}><span>{it.label}</span></label>
                    ))}
                  </div>
                </div>
              ))}
              <div class="chip-group">
                <h3>Не определились?</h3>
                <div class="chips">
                  <label class="chip chip--dk"><input type="checkbox" id="svc-dontknow" value="diagnostika"><span>Не знаю — нужна диагностика</span></label>
                </div>
              </div>
            </div>
              <div class="field" id="svc-err-anchor"><span class="err" role="alert"></span></div>
              <div class="field u-mt26">
                <span class="f-label">Фото автомобиля или повреждения <span class="opt">до 3 файлов, необязательно</span></span>
                <span class="hint">Помогает оценить задачу до визита. Фото (до 3 файлов, до 15 МБ каждое) загружаются на сервер сервиса и видны только сотрудникам.</span>
                <input type="file" id="f-photos" accept="image/*" multiple hidden>
                <div class="photos" id="photos"></div>
              </div>
            </div>

            <div class="step" data-step="3" aria-hidden="true">
              <h2>Когда вам удобно</h2>
              <p class="step-desc">Работаем {S.hours}. Запись — на ближайшие 14 дней, шаг один час. Занятое время видно сразу и недоступно для выбора; формат даты — ДД.ММ.ГГГГ.</p>
              <div class="field">
                <span class="f-label">Дата визита</span>
                <div class="cal" id="cal" role="group" aria-label="Выбор даты: ближайшие 14 дней"></div>
              </div>
              <div class="field u-mt16">
                <span class="f-label" id="slot-title">Время визита</span>
                <div class="slots" id="slots" role="group" aria-label="Выбор времени"></div>
                <div class="slot-legend">
                  <span><i class="u-bar-mist2"></i>свободно</span>
                  <span><i class="u-bar-copper"></i>выбрано</span>
                  <span><i class="u-bar-mist1"></i>занято (недоступно)</span>
                </div>
                <div class="asap">
                  <p>Не можете выбрать день? Подберём ближайшее окно и перезвоним для подтверждения.</p>
                  <button type="button" class="skip-chip" id="asap-btn" aria-pressed="false">Как можно скорее</button>
                </div>
              </div>
              <div class="field" id="when-err-anchor"><span class="err" role="alert"></span></div>
            </div>

            <div class="step" data-step="4" aria-hidden="true">
              <h2>Как с вами связаться</h2>
              <p class="step-desc">E-mail не спрашиваем — для подтверждения записи хватает телефона. Имя нужно, чтобы знать, как к вам обращаться.</p>
              <div class="fields">
                <div class="field">
                  <label for="f-name">Имя <span class="req" aria-hidden="true">*</span></label>
                  <input class="input" type="text" id="f-name" name="name" autocomplete="name" placeholder="Как к вам обращаться">
                  <span class="err" role="alert"></span>
                </div>
                <div class="field">
                  <label for="f-phone">Телефон <span class="req" aria-hidden="true">*</span></label>
                  <input class="input" type="tel" id="f-phone" name="phone" data-mask inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" aria-describedby="phone-hint">
                  <span class="hint" id="phone-hint">Формат +7 (999) 999-99-99 · вставка из буфера работает</span>
                  <span class="err" role="alert"></span>
                </div>
                <div class="field field--full">
                  <span class="f-label" id="channel-label">Как удобнее связаться</span>
                  <div class="radio-row" role="radiogroup" aria-labelledby="channel-label">
                    <label class="radio-card"><input type="radio" name="channel" value="call" checked><span>Звонок по телефону</span></label>
                    <label class="radio-card"><input type="radio" name="channel" value="telegram"><span>Написать в Telegram</span></label>
                  </div>
                </div>
                <div class="field field--full">
                  <div class="field u-sr" aria-hidden="true">
                <label>Служебное поле — не заполняйте его
                  <input id="hp-website" name="hp_website" type="text" tabindex="-1" autocomplete="off">
                </label>
              </div>
              <div class="consent-row" id="consent-row">
                    <input type="checkbox" id="f-consent" aria-describedby="consent-hint">
                    <div class="u-flex1">
                      <label for="f-consent">Согласен(на) на обработку персональных данных <span class="req" aria-hidden="true">*</span></label>
                      <span class="hint u-blk-mt4" id="consent-hint">
                        <button type="button" class="linklike" data-modal="consent">Текст согласия</button> ·
                        <button type="button" class="linklike" data-modal="policy">Политика конфиденциальности</button> ·
                        галочка не проставлена заранее
                      </span>
                      <span class="err" role="alert"></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="step" data-step="5" aria-hidden="true">
              <h2>Проверьте заявку</h2>
              <p class="step-desc">Всё выбранное — одним экраном. Что-то не так? Кнопка «изменить» вернёт на нужный шаг, данные не потеряются.</p>
              <div class="sum-list" id="summary"></div>
              <p class="hint">Нажмите «Отправить заявку» — она сразу уйдёт в сервис: вы получите номер, а мастер — уведомление в Telegram и письмом. Если один канал доставки временно недоступен, заявка не потеряется: доставка повторится автоматически.</p>
            </div>

          </div>
          <div class="wiz-foot">
            <div class="wiz-nav">
              <button class="btn btn--ghost u-invisible" type="button" id="wiz-back">Назад</button>
              <button class="btn btn--copper" type="button" id="wiz-next">Далее</button>
              <button class="btn btn--copper u-none" type="button" id="wiz-submit">Отправить заявку</button>
            </div>
          </div>
          <noscript><p class="hint">Форма записи работает с включённым JavaScript. Без него запишитесь, пожалуйста, по телефону: {S.phone_main} ({S.hours}).</p></noscript>
          <div class="payload" id="payload">
            <button class="payload-btn" type="button" id="payload-btn" aria-expanded="false" aria-controls="payload-pre"><span class="car" aria-hidden="true">▶</span> Что уйдёт на сервер (JSON payload)</button>
            <pre id="payload-pre"></pre>
          </div>
        </div>

        <div class="wiz-state" id="state-sending" role="status" aria-live="polite">
          <div class="spinner" aria-hidden="true"></div>
          <p>Отправляем заявку…</p>
        </div>

        <div class="wiz-state" id="state-ok" role="status" aria-live="polite">
          <div class="ticket">
            <div class="ok"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12.5 2.5 2.5L16 9.5"/></svg><b>Заявка принята</b></div>
            <div class="no"><small>Номер заявки — назовите его при звонке</small><span id="ok-no">—</span></div>
            <p class="hint" id="ok-dup" hidden>Повторная отправка: эта заявка уже принята — дубль не создан (идемпотентность по ключу).</p>
            <dl id="ok-dl"></dl>
          </div>
          <div class="next-steps">
            <h3>Что дальше</h3>
            <ul>
              <li>Перезвоним с номера {S.phone_main} (или напишем в Telegram — как выбрали) и подтвердим визит.</li>
              <li>Если выбрана диагностика: мастер осмотрит автомобиль и подготовит смету до начала работ.</li>
              <li>Планы изменились? Позвоните — перенесём время без обид и уговоров.</li>
            </ul>
            <h3>Что взять с собой</h3>
            <ul>
              <li>Свидетельство о регистрации (СТС) и ключи от автомобиля.</li>
              <li>Для переобувки — второй комплект колёс, если он не хранится у нас.</li>
              <li>Сервисную книжку или записи прошлых работ — если есть, помогут с историей.</li>
            </ul>
          </div>
          <p class="u-actions-center">
            <button class="btn btn--ghost" type="button" id="ok-ics">Добавить в календарь (.ics)</button>
            <button class="btn btn--copper" type="button" id="ok-again">Создать новую заявку</button>
            <a class="btn btn--ghost" href="/" id="ok-home">На главную</a>
          </p>
          <p class="hint u-mt16">Заявка записана в базу сервиса и сразу передана в доставку: владельцу в Telegram и письмом на почту. Если канал временно недоступен — доставка повторится автоматически, заявка не потеряется.</p>
        </div>

        <div class="wiz-state" id="state-err" role="alert" aria-live="assertive">
          <div class="err-box">
            <div class="head"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7v6M12 16.5v.5"/></svg><b>Не удалось отправить заявку</b></div>
            <p id="err-text">Сервер не ответил или отклонил заявку. Введённые данные сохранены — заново ничего вводить не нужно. Повторите отправку или позвоните нам: {S.phone_main}.</p>
            <p class="u-flex-mt18">
              <button class="btn btn--copper" type="button" id="err-retry">Повторить отправку</button>
              <a class="btn btn--ghost" href={`tel:${S.phone_main_tel}`} data-track="call_click">Позвонить: {S.phone_main}</a>
            </p>
            </div>
        </div>
      </form>
    </div>

    <aside class="svc-side reveal" data-d="1" aria-labelledby="appt-side-h">
      <h3 id="appt-side-h">Быстрее — по телефону</h3>
      <p>Форма удобна, но звонок ещё быстрее: мастер ответит, оценит задачу и запишет на визит.</p>
      <a class="svc-side-tel" href={`tel:${S.phone_main_tel}`} data-track="call_click"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg> {S.phone_main}</a>
      <small>{S.hours}</small>
      <a class="svc-side-tel u-mt6" href={`${S.telegram_url}`} data-track="telegram_click"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 4.5 2.8 11.3c-.9.3-.9 1.6.1 1.8l4.6 1.2 1.8 5.4c.3.8 1.3 1 1.8.3l2.5-3 4.6 3.4c.7.5 1.7.1 1.9-.7l3.2-14c.2-1-.7-1.8-1.8-1.2z"/><path d="m7.5 14.3 11-7.8-8.4 9.4"/></svg> Telegram {S.telegram_phone}</a>
      <small>для переписки и фото повреждения</small>
      <p class="u-mt10"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> {S.address_full}<br><small class="u-mist">ост. «3-й Поселковый» ~330 м · рядом база «Бум» · <a href={`${S.map_link}`} data-track="route_click" class="u-brass">схема проезда</a></small></p>
      <div class="price-note u-m6-0-0">
        <b>Гарантия и документы</b>
        <p>На работы действует гарантия — условия фиксируются в заказ-наряде. Обслуживаем физлиц и парки.</p>
      </div>
    </aside>
  </div>
</section>

  <script>import '../client/wizard.ts';</script>
</Base>
