---
/**
 * «Наши работы» — страница всех работ (задание 79-2).
 *
 * Работы читаются из `site/content/cases.json` (`cases-store`), фото лежат
 * в `/media/cases/<slug>/…`. Слова «кейс» в публичных текстах нет: раздел
 * называется «Наши работы».
 *
 * Страницы пагинации — настоящие пути `/raboty/page/2`, а не query-строка:
 * на GitHub Pages query не рендерится сервером. Разметка одна: файл
 * `pages/raboty/page/[page].astro` рендерит этот же компонент, а номер
 * страницы берётся из пути.
 */
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getSettings } from '../server/settings.ts';
import { listPublishedSiteCases } from '../server/cases-store.ts';
import { listCatalogServices } from '../server/services.ts';
import { fmtDateRu } from '../server/format.ts';

const S = getSettings();
const PER = 24;

const all = listPublishedSiteCases(0);
const total = all.length;
const pages = Math.max(1, Math.ceil(total / PER));

/* Номер страницы — из пути (/raboty/page/3). Хвостовой слеш допустим. */
const m = Astro.url.pathname.match(/\/raboty(?:\/page\/(\d+))?\/?$/);
const requested = Math.max(1, parseInt(m?.[1] ?? '1', 10) || 1);
const pageNum = Math.min(requested, pages);
const items = all.slice((pageNum - 1) * PER, pageNum * PER);

/* Услуга в карточке — только если она реально есть в каталоге. */
const svcBySlug = new Map(listCatalogServices().map((s) => [s.slug, s]));
const pageUrl = (p: number): string => (p > 1 ? `/raboty/page/${p}` : '/raboty');

const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const title = pageNum > 1 ? `Наши работы — страница ${pageNum}` : 'Наши работы: фото ремонта и обслуживания';
const description = 'Фотографии с ремонтов и обслуживания на Портовой, 439: что привезли, что сделали и как это выглядит после работы.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Наши работы', item: siteUrl + '/raboty' },
  ],
};
---

<Base page="works" title={title} description={description} jsonLd={jsonLd}>
  <nav class="crumbs container" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span class="sep" aria-hidden="true">/</span>
    {pageNum > 1
      ? <><a href="/raboty">Наши работы</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">Страница {pageNum}</span></>
      : <span class="cur" aria-current="page">Наши работы</span>}
  </nav>

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Работы</span>
      <h1>Наши работы</h1>
      <p class="lead">Фотографии с ремонтов и обслуживания на Портовой, 439. Сначала смета — потом работа.</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="works-h">
    <div class="container works-body">
      <h2 id="works-h" class="u-sr">Список работ</h2>

      {items.length ? (
        <>
          <div class="works-grid">
            {items.map((w) => {
              const svc = w.service_slug ? svcBySlug.get(w.service_slug) ?? null : null;
              return (
                <CaseCard
                  case={w}
                  mode="link"
                  variant="grid"
                  service={svc ? { slug: svc.slug, title: svc.title } : null}
                  date={fmtDateRu(w.published_at)}
                  pair={w.mode === 'before_after' && w.before.length > 0 && w.after.length > 0}
                />
              );
            })}
          </div>
          {pages > 1 && (
            <nav class="pager works-pager" aria-label="Страницы работ">
              {pageNum > 1
                ? <a href={pageUrl(pageNum - 1)} rel="prev" aria-label="Предыдущая страница">← Назад</a>
                : <span class="pager-off" aria-hidden="true">← Назад</span>}
              <span class="pager-count" aria-current="page">Страница {pageNum} из {pages}</span>
              {pageNum < pages
                ? <a href={pageUrl(pageNum + 1)} rel="next" aria-label="Следующая страница">Вперёд →</a>
                : <span class="pager-off" aria-hidden="true">Вперёд →</span>}
            </nav>
          )}
        </>
      ) : (
        <div class="works-empty">
          <b>Работ пока нет</b>
          <p>Фотографии работ появятся здесь, когда мы их снимем и загрузим. Пока посмотрите услуги и цены или запишитесь на визит.</p>
          <p class="works-empty-btns">
            <a class="btn btn--copper" href="/services">Услуги и цены</a>
            <a class="btn btn--ghost" href="/appointment">Записаться</a>
          </p>
        </div>
      )}

      <div class="case-cta">
        <div>
          <b>Нужен такой же ремонт?</b>
          <p>Позвоните — скажем, что делаем в вашем случае и сколько это стоит до начала работ.</p>
        </div>
        <p class="case-cta-btns">
          <a class="btn btn--copper" href="/appointment">Записаться</a>
          <a class="btn btn--ghost" href={`tel:${S.phone_main_tel}`} data-track="call_click">{S.phone_main}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
