---
/* Круг 26 (задание №30 §2.4): страница гарантий. Текст — content/merged-r26/a8/03-trust.md (7 пунктов),
   метатеги — a8/06-seo.md. В шапку не добавляем (пунктов уже семь с «Прайсом»): подвал + ссылка с /about. */
import Base from '../layouts/Base.astro';
import { getSettings } from '../server/settings.ts';

const S = getSettings();
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');

const POINTS = [
  { h: 'Смета до начала работ', p: 'До ремонта осматриваем автомобиль, объясняем обнаруженное и называем стоимость работ. Приступаем после вашего согласия. Если по ходу появляется дополнительный объём, сначала сообщаем об этом и согласуем цену.' },
  { h: 'Показываем, что требует замены', p: 'Объясняем, почему предлагаем заменить деталь или выполнить работу. По возможности показываем снятую деталь и отвечаем на вопросы простыми словами.' },
  { h: 'Не предлагаем лишнего', p: 'Отделяем то, что нужно сделать сейчас, от того, что можно запланировать позже. Решение о работах всегда остаётся за вами.' },
  { h: 'От диагностики до выдачи', p: 'Можем выполнить работы под ключ: от первичной диагностики и согласования сметы до ремонта и выдачи машины. Конкретный объём определяем после осмотра.' },
  { h: 'Гарантийные условия — в заказ-наряде', p: 'Условия гарантии фиксируем в заказ-наряде: там указан срок для каждой работы.' },
  { h: 'Если возник вопрос после ремонта', p: 'Свяжитесь с нами по телефону или приезжайте в сервис с заказ-нарядом. Опишите, что произошло и когда вы это заметили; мы проверим обращение и объясним дальнейшие действия.' },
  { h: 'Стоимость за работу', p: 'Цены на сайте указаны за работу, без запчастей. Если окончательная сумма зависит от автомобиля или состояния узла, назовём её после осмотра и до начала ремонта.' },
];

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Гарантии' },
  ],
};
---
<Base
  page="garantii"
  title="Гарантии и правила сервиса — АвтоТехСервис"
  description="Согласуем стоимость до начала работ, объясним результаты осмотра и зафиксируем условия гарантии в заказ-наряде."
  jsonLd={jsonLd}
>

<nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">Гарантии</span></nav>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Гарантии</span>
    <h1>Гарантии и правила сервиса</h1>
    <p class="lead">Семь правил, по которым работает сервис на Портовой, 439. Они же — то, что вы вправе спросить с нас при выдаче автомобиля.</p>
  </div>
</section>
<section class="sec" aria-labelledby="gar-h">
  <div class="container container--gar">
    <h2 id="gar-h" class="u-sr">Правила сервиса</h2>
    <ol class="gar-list">
      {POINTS.map((pt, i) => (
        <li class="gar-item">
          <span class="gar-n" aria-hidden="true">{i + 1}</span>
          <div><h3>{pt.h}</h3><p>{pt.p}</p></div>
        </li>
      ))}
    </ol>
    <p class="u-chips-mt26">
      <a class="btn btn--copper" href="/appointment">Записаться на визит</a>
      <a class="btn btn--ghost" href="/prices">Прайс на работы</a>
    </p>
    <p class="gar-note">Вопросы по гарантийным случаям — по телефону {S.phone_main} или в сервисе с заказ-нарядом. {S.hours}.</p>
  </div>
</section>

</Base>
