---
import Base from '../layouts/Base.astro';
import { getSettings } from '../server/settings.ts';
import { listCatalogServices, listHomeServices } from '../server/services.ts';
import { listPublishedCases, listPublishedReviews, coverInfo } from '../server/content.ts';
import { fmtDateRu, plural } from '../server/format.ts';

const S = getSettings();
const services = listHomeServices();
import { SVC_IMG } from '../server/svc-img.ts';
/* круг 28: раздел Voyah Free живёт на своём CSS (токены --v-*) */
import '../styles/voyah.css';
const cases = listPublishedCases(6);
const reviews = listPublishedReviews(8);
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: S.site_name,
  description: 'Автосервис и шиномонтаж на Западном: колёса, ремонт и обслуживание, диагностика. Сначала смета — потом ремонт.',
  url: siteUrl + '/',
  image: siteUrl + '/img/og.png',
  telephone: S.phone_main_tel,
  address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: S.city, streetAddress: S.address },
  geo: { '@type': 'GeoCoordinates', latitude: S.coords.lat, longitude: S.coords.lon },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '09:00', closes: '19:00',
  }],
};
---
<Base
  page="home"
  title="Автосервис на Портовой: цена работы до ремонта"
  description="Автосервис и шиномонтаж на Западном. Цены на работы до ремонта, диагностика ходовой от 500 ₽. Ежедневно 9:00–19:00."
  jsonLd={jsonLd}
>

<section class="hero" id="hero" aria-roledescription="карусель" aria-label="Первый экран">
  <div class="hero-track">
      <div class="slide is-active" role="group" aria-roledescription="слайд" aria-label="Слайд 1 из 3">
        <div class="slide-bg">
          <picture>
            <source type="image/avif" media="(max-width:640px)" srcset="/img/hero-service-m-640.avif 640w, /img/hero-service-m-960.avif 960w" sizes="100vw">
            <source type="image/webp" media="(max-width:640px)" srcset="/img/hero-service-m-640.webp 640w, /img/hero-service-m-960.webp 960w" sizes="100vw">
            <source type="image/avif" srcset="/img/hero-service-640.avif 640w, /img/hero-service-960.avif 960w, /img/hero-service-1600.avif 1600w, /img/hero-service-2560.avif 2560w" sizes="100vw">
            <source type="image/webp" srcset="/img/hero-service-640.webp 640w, /img/hero-service-960.webp 960w, /img/hero-service-1600.webp 1600w, /img/hero-service-2560.webp 2560w" sizes="100vw">
            <img class="f16" src="/img/hero-service-1600.webp" width="1600" height="900" alt="Фасад «АвтоТехСервис» на Портовой, 439 в сумерках: вывеска с телефонами, два рабочих бокса и две машины перед фасадом" fetchpriority="high" decoding="async">
          </picture>
        </div>
        <div class="slide-in container">
          <span class="slide-eyebrow">Автосервис и шиномонтаж на Западном</span>
          <h1>Автосервис на Портовой, 439 — цена работы до ремонта</h1>
          <p class="slide-sub">Сначала осмотр и смета. Согласуем стоимость, затем выполняем только те работы, которые вы подтвердили.</p>
          <div class="slide-cta">
          <a class="btn btn--copper" href="/appointment">Записаться</a>
          <a class="btn btn--ghost btn-phone" href={`tel:${S.phone_main_tel}`} data-track="call_click">Позвонить<span class="btn-phone-num">: {S.phone_main}</span></a>
          </div>
        </div>
      </div>
      <div class="slide" role="group" aria-roledescription="слайд" aria-label="Слайд 2 из 3">
        <div class="slide-bg">
          <picture>
            <source type="image/avif" srcset="/img/hero-tools-640.avif 640w, /img/hero-tools-960.avif 960w, /img/hero-tools-1600.avif 1600w, /img/hero-tools-2032.avif 2032w" sizes="100vw">
            <source type="image/webp" srcset="/img/hero-tools-640.webp 640w, /img/hero-tools-960.webp 960w, /img/hero-tools-1600.webp 1600w, /img/hero-tools-2032.webp 2032w" sizes="100vw">
            <img src="/img/hero-tools-1600.webp" width="1600" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async">
          </picture>
        </div>
        <div class="slide-in container">
          <span class="slide-eyebrow">Без ремонта вслепую</span>
          <p class="h1">Сначала смета — потом ремонт</p>
          <p class="slide-sub">Объясним, что обнаружили, назовём стоимость работ до начала и согласуем с вами следующий шаг.</p>
          <div class="slide-cta">
          <a class="btn btn--copper" href="/appointment?s=diagnostika">Записаться на диагностику</a>
          <a class="btn btn--ghost" href="/contacts">Узнать адрес</a>
          </div>
        </div>
      </div>
      <div class="slide" role="group" aria-roledescription="слайд" aria-label="Слайд 3 из 3">
        <div class="slide-bg">
          <picture>
            <source type="image/avif" srcset="/img/hero-tyre-640.avif 640w, /img/hero-tyre-960.avif 960w, /img/hero-tyre-1600.avif 1600w, /img/hero-tyre-2032.avif 2032w" sizes="100vw">
            <source type="image/webp" srcset="/img/hero-tyre-640.webp 640w, /img/hero-tyre-960.webp 960w, /img/hero-tyre-1600.webp 1600w, /img/hero-tyre-2032.webp 2032w" sizes="100vw">
            <img src="/img/hero-tyre-1600.webp" width="1600" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async">
          </picture>
        </div>
        <div class="slide-in container">
          <span class="slide-eyebrow">Шиномонтаж на Портовой</span>
          <p class="h1">Комплект R16 — 2200 ₽ за работу</p>
          <p class="slide-sub">Цена указана за четыре колеса. Позвоните, чтобы выбрать удобное время и уточнить детали.</p>
          <div class="slide-cta">
          <a class="btn btn--copper" href="/appointment?s=shinomontazh">Записаться на шиномонтаж</a>
          <a class="btn btn--ghost btn-phone" href={`tel:${S.phone_main_tel}`} data-track="call_click">Позвонить<span class="btn-phone-num">: {S.phone_main}</span></a>
          </div>
        </div>
      </div>
  </div>
  <div class="hero-ui">
    <div class="container">
      <button class="hero-arrow" id="hero-prev" type="button" aria-label="Предыдущий слайд">←</button>
      <button class="hero-arrow" id="hero-next" type="button" aria-label="Следующий слайд">→</button>
      <span class="hero-note">Автопрокрутка · пауза при наведении · свайп</span>
      <div class="hero-dots" id="hero-dots" aria-label="Слайды"></div>
    </div>
  </div>
  <a class="hero-scroll" href="#strip" aria-label="Прокрутить к фото сервиса">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
  </a>
</section>
<section class="strip" id="strip" aria-label="Фотографии сервиса">
  <figure class="strip-item reveal" data-d="0">
    <picture>
      <source type="image/avif" srcset="/img/strip-sign.avif">
      <source type="image/webp" srcset="/img/strip-sign.webp">
      <img src="/img/strip-sign.webp" width="1200" height="500" alt="Шиномонтаж: руки в перчатках ставят покрышку на диск под тёплой лампой" loading="lazy" decoding="async">
    </picture>
    <figcaption>Шиномонтаж и ремонт в одном месте</figcaption>
  </figure>
  <figure class="strip-item reveal" data-d="1">
    <picture>
      <source type="image/avif" srcset="/img/strip-bay.avif">
      <source type="image/webp" srcset="/img/strip-bay.webp">
      <img src="/img/strip-bay.webp" width="1200" height="500" alt="Бокс изнутри: автомобиль на подъёмнике, кирпичные стены и красные шкафы" loading="lazy" decoding="async">
    </picture>
    <figcaption>Портовая, 439 — два бокса</figcaption>
  </figure>
  <figure class="strip-item reveal" data-d="2">
    <picture>
      <source type="image/avif" srcset="/img/strip-gates.avif">
      <source type="image/webp" srcset="/img/strip-gates.webp">
      <img src="/img/strip-gates.webp" width="1200" height="500" alt="Двигатель под лампой и планшет диагностики: осмотр перед сметой" loading="lazy" decoding="async">
    </picture>
    <figcaption>Работаем ежедневно 9:00–19:00</figcaption>
  </figure>
</section>
<section class="sec sec--deep dirs" aria-labelledby="tri-h">
  {/* РАУНД 17 / приёмка: фон секции — такой же слой <picture>, как у карточек, а не CSS
      background-image. Причина: минцификатор сборки переписывает объявление внутри @supports
      в голые строки image-set("/img/…" 1x type("image/avif")), а export-pages.mjs умел
      префиксовать только url(…) — в итоге на Pages под /avtotehservis/ фон 404-ился.
      Заодно <picture> даёт avif/webp и мобильный кадр без media-хаков в CSS. */}
  <div class="dirs-bg" aria-hidden="true">
    <picture>
      <source media="(max-width:640px)" type="image/avif" srcset="/img/tri-bg-m-900.avif">
      <source media="(max-width:640px)" type="image/webp" srcset="/img/tri-bg-m-900.webp">
      <source type="image/avif" srcset="/img/tri-bg-2560.avif">
      <source type="image/webp" srcset="/img/tri-bg-2560.webp">
      <img src="/img/tri-bg-2560.webp" width="2560" height="1440" alt="" loading="lazy" decoding="async">
    </picture>
  </div>
  <div class="container">
    <div class="sec-head reveal">
      <span class="eyebrow">Три направления</span>
      <h2 id="tri-h">Чем сервис занимается каждый день</h2>
    </div>
    <div class="tri">
      <article class="tri-card reveal" data-d="0">
        <div class="tri-bg" aria-hidden="true"><picture><source srcset="/img/tri-wheel-1600.avif 1600w, /img/tri-wheel-960.avif 960w, /img/tri-wheel-640.avif 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/avif"><source srcset="/img/tri-wheel-1600.webp 1600w, /img/tri-wheel-960.webp 960w, /img/tri-wheel-640.webp 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/webp"><img src="/img/tri-wheel-960.webp" width="960" height="640" alt="" loading="lazy" decoding="async"></picture></div>
        <span class="tri-num" aria-hidden="true">01</span>
        <h3>Колёса</h3>
        <p>Шиномонтаж комплекта R13 — 1800 ₽, R16 — 2200 ₽, R20 — 3600 ₽. Это стоимость работы за четыре колеса; смена готовых колёс — 1000 ₽ за комплект, ремонт колеса — от 600 ₽ за колесо. Выполняем балансировку.</p>
        <a class="link-more" href="/services/shinomontazh">Шиномонтаж и колёса <span class="ar" aria-hidden="true">→</span></a>
      </article>
      <article class="tri-card tri-card--accent reveal" data-d="1">
        <div class="tri-bg" aria-hidden="true"><picture><source srcset="/img/tri-serv-1600.avif 1600w, /img/tri-serv-960.avif 960w, /img/tri-serv-640.avif 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/avif"><source srcset="/img/tri-serv-1600.webp 1600w, /img/tri-serv-960.webp 960w, /img/tri-serv-640.webp 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/webp"><img src="/img/tri-serv-960.webp" width="960" height="640" alt="" loading="lazy" decoding="async"></picture></div>
        <span class="tri-num" aria-hidden="true">02</span>
        <h3>Ремонт и ТО</h3>
        <p>Замена масла в двигателе — от 1000 ₽ на седане и от 1300 ₽ на кроссовере. Тормозные колодки — 1200 ₽; диски с колодками — 2200–4000 ₽. Подвеска, сцепление, ГРМ, а сварочные работы по выхлопу — от 1500 ₽ за место.</p>
        <a class="link-more" href="/services/to-maslo">Ремонт и ТО <span class="ar" aria-hidden="true">→</span></a>
      </article>
      <article class="tri-card reveal" data-d="2">
        <div class="tri-bg" aria-hidden="true"><picture><source srcset="/img/tri-diag-1600.avif 1600w, /img/tri-diag-960.avif 960w, /img/tri-diag-640.avif 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/avif"><source srcset="/img/tri-diag-1600.webp 1600w, /img/tri-diag-960.webp 960w, /img/tri-diag-640.webp 640w" sizes="(max-width:640px) 92vw, (max-width:1024px) 96vw, 375px" type="image/webp"><img src="/img/tri-diag-960.webp" width="960" height="640" alt="" loading="lazy" decoding="async"></picture></div>
        <span class="tri-num" aria-hidden="true">03</span>
        <h3>Диагностика</h3>
        <p>Диагностика ходовой — от 500 ₽, компьютерная — 800 ₽. Проверим, откуда стук или индикатор. Автокондиционеры: заправка — 2000 ₽, поиск утечки — от 500 ₽, делаем любой ремонт.</p>
        <a class="link-more" href="/services/diagnostika">Диагностика и кондиционеры <span class="ar" aria-hidden="true">→</span></a>
      </article>
    </div>
    <p class="tri-note">Цены указаны за работу, без запчастей. Стоимость зависит от автомобиля и объёма работ; точную сумму согласуем до начала.</p>
  </div>
</section>
<section class="sec sec--narrow about" aria-labelledby="about-h">
  <div class="about-bg" aria-hidden="true">
    <picture>
      <source media="(max-width:1024px)" type="image/avif" srcset="/img/about-bg-m-640.avif 640w, /img/about-bg-m-1200.avif 1200w" sizes="100vw">
      <source media="(max-width:1024px)" type="image/webp" srcset="/img/about-bg-m-640.webp 640w, /img/about-bg-m-1200.webp 1200w" sizes="100vw">
      <source type="image/avif" srcset="/img/about-bg-1600.avif 1600w, /img/about-bg-2560.avif 2560w" sizes="100vw">
      <source type="image/webp" srcset="/img/about-bg-1600.webp 1600w, /img/about-bg-2560.webp 2560w" sizes="100vw">
      <img src="/img/about-bg-1600.webp" width="2560" height="1440" alt="" loading="lazy" decoding="async">
    </picture>
  </div>
  <div class="container">
    <div class="sec-head sec-head--wide reveal">
      <span class="eyebrow">О компании</span>
      <h2 id="about-h">«АвтоТехСервис» на Западном: честно, по делу, с сметой до работ</h2>
    </div>
    <div class="about-grid">
    <div class="reveal">
      <p class="lead">Мы — автосервис и шиномонтаж на улице Портовой, 439: рядом с остановкой «3-й Поселковый» и базой «Бум». Принимаем легковые автомобили, кроссоверы и паркетники ежедневно, с 9:00 до 19:00.</p>
      <p class="lead u-mt14">За одним визитом здесь закрывают и «переобуться», и стук в подвеске, и горящий «чек»: от балансировки до тормозов, подвески и ГРМ. Правило одно для всех работ — сначала показываем проблему и называем стоимость, потом берёмся за инструмент.</p>
      <p class="u-mt24"><a class="btn btn--ghost" href="/about"><span class="btn-bg" aria-hidden="true"><picture><source srcset="/img/about-btn-320.avif 320w, /img/about-btn-640.avif 640w" sizes="252px" type="image/avif"><source srcset="/img/about-btn-320.webp 320w, /img/about-btn-640.webp 640w" sizes="252px" type="image/webp"><img src="/img/about-btn-320.webp" alt="" loading="lazy" decoding="async"></picture></span>Подробнее о сервисе</a></p>
    </div>
    <figure class="about-media reveal" data-d="1">
      <picture>
        <source type="image/avif" srcset="/img/about-service-640.avif 640w, /img/about-service-960.avif 960w, /img/about-service-1600.avif 1600w" sizes="(max-width:1024px) 92vw, 46vw">
        <source type="image/webp" srcset="/img/about-service-640.webp 640w, /img/about-service-960.webp 960w, /img/about-service-1600.webp 1600w" sizes="(max-width:1024px) 92vw, 46vw">
        <img src="/img/about-service-960.webp" width="1600" height="1000" alt="Фасад «АвтоТехСервис» на Портовой, 439: баннер с брендами, две машины в боксах и стойка NGN у входа" loading="lazy" decoding="async">
      </picture>
      <figcaption>{S.address_full} — въезд со стороны Портовой</figcaption>
    </figure>
    </div>
    <div class="facts facts--strip">
        <div class="fact"><div class="fact-bg" aria-hidden="true"><picture><source srcset="/img/about-f1-640.avif 640w, /img/about-f1-1280.avif 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/avif"><source srcset="/img/about-f1-640.webp 640w, /img/about-f1-1280.webp 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/webp"><img src="/img/about-f1-640.webp" alt="" loading="lazy" decoding="async"></picture></div><b>{S.address_full}</b><span>ост. «3-й Поселковый» ~330 м</span></div>
        <div class="fact"><div class="fact-bg" aria-hidden="true"><picture><source srcset="/img/about-f2-640.avif 640w, /img/about-f2-1280.avif 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/avif"><source srcset="/img/about-f2-640.webp 640w, /img/about-f2-1280.webp 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/webp"><img src="/img/about-f2-640.webp" alt="" loading="lazy" decoding="async"></picture></div><b>{S.hours}</b><span>без выходных</span></div>
        <div class="fact"><div class="fact-bg" aria-hidden="true"><picture><source srcset="/img/about-f3-640.avif 640w, /img/about-f3-1280.avif 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/avif"><source srcset="/img/about-f3-640.webp 640w, /img/about-f3-1280.webp 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/webp"><img src="/img/about-f3-640.webp" alt="" loading="lazy" decoding="async"></picture></div><b>{S.phone_main}</b><span>Telegram: {S.telegram_phone}</span></div>
        <div class="fact"><div class="fact-bg" aria-hidden="true"><picture><source srcset="/img/about-f4-640.avif 640w, /img/about-f4-1280.avif 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/avif"><source srcset="/img/about-f4-640.webp 640w, /img/about-f4-1280.webp 1280w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 285px" type="image/webp"><img src="/img/about-f4-640.webp" alt="" loading="lazy" decoding="async"></picture></div><b>Гарантия в заказ-наряде</b><span>условия и срок по каждой операции</span></div>
      </div>

  </div>
  <div class="container">
    <div class="feats">
      <div class="feat reveal" data-d="0">
        <div class="feat-bg" aria-hidden="true"><picture><source srcset="/img/about-c1-480.avif 480w, /img/about-c1-720.avif 720w, /img/about-c1-1080.avif 1080w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 278px" type="image/avif"><source srcset="/img/about-c1-480.webp 480w, /img/about-c1-720.webp 720w, /img/about-c1-1080.webp 1080w" sizes="(max-width:768px) 92vw, (max-width:1024px) 48vw, 278px" type="image/webp"><img src="/img/about-c1-720.webp" alt="" loading="lazy" decoding="async"></picture></div>
        <span class="feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></span>
        <h3>Смета до начала работ</h3>
        <p>Перечень и стоимость — до первого оборота ключа. Согласовали — работаем.</p>
      </div>
      <div class="feat reveal" data-d="1">
