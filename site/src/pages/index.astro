      <a class="btn btn--copper" href="/appointment?s=diagnostika">Записаться на диагностику</a>
      <p class="u-mt14-fs13">Или позвоните: <a href={`tel:${S.phone_main_tel}`} data-track="call_click" class="u-brass"><b>{S.phone_main}</b></a></p>
