<section class="sec" aria-labelledby="gal-h">
  <div class="container">
    <div class="sec-head reveal">
      <div>
        <span class="eyebrow">Галерея работ</span>
        <h2 id="gal-h">Шесть кейсов «до / после»</h2>
      </div>
      <div class="slider-nav">
        <button class="hero-arrow" type="button" data-car="prev" aria-label="Предыдущие кейсы">←</button>
        <button class="hero-arrow" type="button" data-car="next" aria-label="Следующие кейсы">→</button>
      </div>
    </div>
    <div class="carousel reveal" data-carousel>
      <div class="carousel-win">
        <div class="carousel-track gal-track">
          {cases.map((c, ci) => {
            const cov = coverInfo(c, '/img/case-1.svg', c.title, '');
            // Раунд 7: фраза-заглушка о съёмке остаётся только в одной заметке под секцией.
            const sub = (c.description ?? '').replace(/\.?\s*Фото появится после съёмки в сервисе\./i, '').trim();
            return (
              <button class="gal-card" type="button" data-gal={ci} data-img={cov.lg} data-title={c.title} data-sub={sub} aria-label={`Открыть кейс: ${c.title}`}>
                <span class="gal-img"><img src={cov.src} srcset={cov.srcset ?? undefined} sizes="(max-width:640px) 84vw, (max-width:1024px) 44vw, 380px" alt={cov.alt} width="800" height="600" loading="lazy" decoding="async"><span class="ba" aria-hidden="true">до / после</span></span>
                <span class="gal-cap">{c.title}</span>
              </button>
            );
          })}
          </div>
      </div>
    </div>
    <p class="gal-note">Показываем только реальные работы — фото появятся после съёмки.</p>
