---
import Base from '../layouts/Base.astro';
import { listNews, NEWS_CATEGORIES, coverInfo, catTitle, newsCategoryCounts, newsTotal } from '../server/news-store.ts';
import { fmtDateRu } from '../server/format.ts';

const PER = 6;
const counts = newsCategoryCounts();
const allCount = newsTotal();
/* Категория и страница — настоящие пути: GitHub Pages не фильтрует query-строку.
   Старые ?cat= и ?page= остаются совместимым входом; путь имеет приоритет. */
const path = Astro.url.pathname.match(/\/news(?:\/cat\/([^/]+))?(?:\/page\/(\d+))?\/?$/);
const cat = path?.[1] ?? Astro.url.searchParams.get('cat');
const requestedPage = Math.max(1, parseInt(path?.[2] ?? Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const first = listNews({ category: cat, page: 1, per: PER });
const pageNum = Math.min(requestedPage, first.pages);
const { items, total, pages } = pageNum === 1 ? first : listNews({ category: cat, page: pageNum, per: PER });
const fallbackCovers = ['/img/news-1.svg', '/img/news-2.svg', '/img/news-3.svg', '/img/news-4.svg'];
const pageUrl = (p: number): string => {
  const base = cat ? `/news/cat/${encodeURIComponent(cat)}` : '/news';
  return p > 1 ? `${base}/page/${p}` : base;
};
const categoryTitle = cat ? catTitle(cat) : null;
/* Круг 89 (§3): у каждой страницы листинга свой заголовок, чтобы /news, /news/page/2
   и категории не конкурировали в выдаче одинаковыми <title>. */
const pageSuffix = pageNum > 1 ? ` — страница ${pageNum}` : '';
const title = categoryTitle
  ? `Полезное: ${categoryTitle}${pageSuffix} — АвтоТехСервис`
  : pageSuffix
    ? `Полезное${pageSuffix} — АвтоТехСервис`
    : 'Полезное: статьи о ремонте и сезоне — АвтоТехСервис';
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Полезное', ...(categoryTitle ? { item: siteUrl + '/news' } : {}) },
    ...(categoryTitle ? [{ '@type': 'ListItem', position: 3, name: categoryTitle }] : []),
  ],
};
---
<Base
  page="news"
  title={title}
  description="Разбираем, когда менять ремень ГРМ, откуда стук в подвеске и почему кондиционер дует тёплым. С ценами по прайсу сервиса."
  jsonLd={jsonLd}
>

<nav class="crumbs container" aria-label="Хлебные крошки">
  <a href="/">Главная</a><span class="sep" aria-hidden="true">/</span>
  {categoryTitle ? (
    <><a href="/news">Полезное</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">{categoryTitle}</span></>
  ) : <span class="cur" aria-current="page">Полезное</span>}
</nav>
<section class="page-head">
  <div class="container">
    <span class="eyebrow">Полезное</span>
    <h1>{categoryTitle ? `Полезное: ${categoryTitle}` : 'Полезное: ремонт, сезон, цены'}</h1>
    <p class="lead">Разбираем, когда менять ремень ГРМ, откуда стук в подвеске и почему кондиционер дует тёплым. С ценами по прайсу сервиса.</p>
  </div>
</section>
<section class="sec" aria-labelledby="news-h">
  <h2 id="news-h" class="u-sr">Список статей раздела «Полезное»</h2>
  <div class="container">
    <div class="filters" role="group" aria-label="Фильтр по категориям">
      <a class={`filter-chip${!cat ? ' is-on' : ''}`} href="/news" data-news-category="" data-news-pages={Math.max(1, Math.ceil(allCount / PER))} aria-current={!cat ? 'page' : undefined}>Все ({allCount})</a>
      {NEWS_CATEGORIES.map((c) => (counts[c.slug] ?? 0) > 0 ? (
        <a class={`filter-chip${cat === c.slug ? ' is-on' : ''}`} href={`/news/cat/${c.slug}`} data-news-category={c.slug} data-news-pages={Math.ceil(counts[c.slug] / PER)} aria-current={cat === c.slug ? 'page' : undefined}>{c.title} ({counts[c.slug]})</a>
      ) : (
        <span class={`filter-chip${cat === c.slug ? ' is-on' : ''}`} aria-disabled="true">{c.title} (0)</span>
      ))}
    </div>
    {items.length ? (
      <div class="news-grid" id="news-grid">
        {items.map((n, ni) => (
          <article class="news-card" data-cat={n.category}>
            <div class="news-img">{(() => { const cov = coverInfo(n, fallbackCovers[ni % fallbackCovers.length], n.title); return (
              <img src={cov.src} srcset={cov.srcset ?? undefined} sizes="(max-width:640px) 92vw, (max-width:1024px) 46vw, 380px" alt={cov.alt} width="800" height="450" loading="lazy">
            ); })()}</div>
            <div class="news-body">
              <div class="news-meta"><span class="news-cat">{catTitle(n.category)}</span><time datetime={(n.published_at ?? '').replace(' ', 'T')}>{fmtDateRu(n.published_at)}</time></div>
              <h3><a href={`/news/${n.slug}`}>{n.title}</a></h3>
              <p>{n.excerpt}</p>
              <a class="link-more u-fs13" href={`/news/${n.slug}`}>Читать <span class="ar" aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="news-empty is-on">
        <b>{cat ? 'В этой категории пока пусто' : 'Статей пока нет'}</b>
        <p class="u-mt6">Новых публикаций пока нет. Загляните позже.</p>
      </div>
    )}
    {items.length > 0 && <p class="hint u-center-mt18">Показано {items.length} из {total}{pageNum > 1 && ` · страница ${pageNum} из ${pages}`}</p>}
    {pages > 1 && (
      <nav class="pager" aria-label="Страницы новостей">
        {pageNum > 1 && <a href={pageUrl(pageNum - 1)} aria-label="Предыдущая страница">←</a>}
        {Array.from({ length: pages }).map((_, pi) => (
          <a href={pageUrl(pi + 1)} class={pi + 1 === pageNum ? 'is-on' : ''} aria-current={pi + 1 === pageNum ? 'page' : undefined}>{pi + 1}</a>
        ))}
        {pageNum < pages && <a href={pageUrl(pageNum + 1)} aria-label="Следующая страница">→</a>}
      </nav>
    )}
  </div>
</section>
<script>
  // Старые ссылки из статей тоже должны работать на Pages, где query не рендерится сервером.
  // Берём href чипа из DOM: экспорт уже добавил к нему префикс репозитория.
  const params = new URLSearchParams(window.location.search);
  if (params.has('cat') || params.has('page')) {
    const path = window.location.pathname.match(/\/news(?:\/cat\/([^/]+))?(?:\/page\/(\d+))?\/?$/);
    const cat = path?.[1] ?? params.get('cat') ?? '';
    const chip = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-news-category]'))
      .find((link) => link.dataset.newsCategory === cat);
    if (chip) {
      const pages = Number(chip.dataset.newsPages) || 1;
      const requested = Number.parseInt(path?.[2] ?? params.get('page') ?? '1', 10) || 1;
      const page = Math.min(Math.max(1, requested), pages);
      const target = new URL(chip.href);
      const pagePath = page > 1 ? `/page/${page}` : '';
      target.pathname = `${target.pathname.replace(/\/$/, '')}${pagePath}/`;
      params.delete('cat');
      params.delete('page');
      target.search = params.toString();
      target.hash = window.location.hash;
      if (target.href !== window.location.href) window.location.replace(target.href);
    }
  }
</script>
</Base>
