---
/* Страница серверной ошибки: намеренно без обращений к БД (может быть недоступна).
   Телефон — константа DEFAULTS из settings.ts (без чтения БД), единый источник с api/leads.ts. */
import { DEFAULTS } from '../server/settings.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/buttons.css';
import '../styles/utils.css';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>Ошибка сервера — АвтоТехСервис</title>
  <meta name="theme-color" content="#0B1410">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <main class="sec">
    <div class="container">
      <span class="eyebrow">Ошибка 500</span>
      <h1>Сервер временно ошибся</h1>
      <p class="lead">Что-то пошло не так на нашей стороне. Мы уже видим ошибку в логах. Обновите страницу через минуту — или позвоните, мы на связи ежедневно 9:00–19:00.</p>
      <p class="u-chips-mt26">
        <a class="btn btn--copper" href={`tel:${DEFAULTS.phone_main_tel}`}>{DEFAULTS.phone_main}</a>
        <a class="btn btn--ghost" href="/">На главную</a>
      </p>
    </div>
  </main>
</body>
</html>
