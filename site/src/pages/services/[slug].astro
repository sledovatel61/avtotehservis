---
import Base from '../../layouts/Base.astro';
import { getSettings } from '../../server/settings.ts';
import { getService, otherServices } from '../../server/services.ts';
import { mdToHtml } from '../../server/markdown.ts';

const S = getSettings();
const { slug } = Astro.params;
const svc = slug ? getService(slug) : undefined;
if (!svc) Astro.response.status = 404;
const others = svc ? otherServices(svc.slug, 3) : [];
const siteUrl = (Astro.site?.href ?? 'http://localhost:4321/').replace(/\/$/, '');
const jsonLd = svc ? [
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: svc.title,
    description: svc.short ?? svc.title,
    serviceType: svc.tag ?? svc.grp ?? 'Автосервис',
    provider: {
      '@type': 'AutoRepair', name: S.site_name,
      address: { '@type': 'PostalAddress', addressCountry: 'RU', addressLocality: S.city, streetAddress: S.address },
      telephone: S.phone_main_tel,
    },
    areaServed: { '@type': 'City', name: S.city },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'Услуги', item: siteUrl + '/services' },
      { '@type': 'ListItem', position: 3, name: svc.title },
    ],
  },
] : undefined;
---
{svc ? (
<Base
  page="service"
  title={svc.seo_title || `${svc.title} — АвтоТехСервис, Ростов-на-Дону`}
  description={svc.seo_description || svc.short || svc.title}
  jsonLd={jsonLd}
>
  <nav class="crumbs container" aria-label="Хлебные крошки"><a href="/">Главная</a><span class="sep" aria-hidden="true">/</span><a href="/services">Услуги</a><span class="sep" aria-hidden="true">/</span><span class="cur" aria-current="page">{svc.title}</span></nav>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow" id="svc-tag">{svc.tag ?? svc.grp}</span>
      <h1 id="svc-title">{svc.title}</h1>
      <p class="lead" id="svc-lead">{svc.short}</p>
    </div>
  </section>
  <section class="sec" aria-labelledby="svc-title">
    <div class="container svc-detail" id="svc-detail">
      <div class="svc-text reveal">
        <div class="svc-detail-img" id="svc-img">
          <img src={svc.icon ?? '/img/svc-1.svg'} alt={`${svc.title} — фото появится после съёмки в сервисе`} width="800" height="600">
        </div>
        <div id="svc-body" set:html={mdToHtml(svc.description ?? '')} />
        <div class="price-note">
          <b>Стоимость — после осмотра</b>
          <p>Прайса нет: цена зависит от состояния автомобиля и объёма работ. Сначала осмотр и смета, потом — решение владельца. Цифры называем до начала работ.</p>
        </div>
      </div>
      <aside class="svc-side reveal" data-d="1">
        <h3>Записаться на услугу</h3>
        <p>Выберите день и час в форме записи — услуга уже будет предвыбрана.</p>
        <a class="btn btn--copper" id="svc-book" href={`/appointment?s=${svc.slug}`}>Записаться</a>
        <a class="svc-side-tel" href={`tel:${S.phone_main_tel}`} data-track="call_click"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg> {S.phone_main}</a>
        <p class="hint">{S.hours} · {S.address_full}</p>
      </aside>
    </div>
  </section>
  <section class="sec sec--deep" aria-labelledby="svc-others-h">
    <div class="container">
      <div class="sec-head reveal">
        <div>
          <span class="eyebrow">Ещё услуги</span>
          <h2 id="svc-others-h">С чем совмещают эту услугу</h2>
        </div>
      </div>
      <div class="svc-grid" id="svc-others">
        {others.map((o) => (
          <a class="svc-card" href={`/services/${o.slug}`}>
            <span class="svc-img"><img src={o.icon ?? '/img/svc-1.svg'} alt={`${o.title} — фото появится после съёмки`} width="800" height="600" loading="lazy"></span>
            <span class="svc-body"><span class="svc-tag">{o.tag ?? o.grp}</span><h3>{o.title}</h3><p>{o.short}</p><span class="link-more">Подробнее <span class="ar" aria-hidden="true">→</span></span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
) : (
<Base page="404" title="Услуга не найдена — АвтоТехСервис" description="Запрошенная услуга не найдена." noindex>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Услуга не найдена</h1>
      <p class="lead">Возможно, страница услуги переехала или адрес набран с ошибкой.</p>
      <p class="u-chips-mt26"><a class="btn btn--copper" href="/services">Все услуги</a> <a class="btn btn--ghost" href="/">На главную</a></p>
    </div>
  </section>
</Base>
)}
