---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import Modals from '../components/Modals.astro';
import { getSettings } from '../server/settings.ts';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/buttons.css';
import '../styles/utils.css';
import '../styles/header.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/modals.css';
import '../styles/pages.css';
import '../styles/wizard.css';
import '../styles/motion.css';
import '../styles/media.css';
import '../styles/misc.css';

export interface Props {
  page: string;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: string;
  publishedTime?: string;
}
const { page, title, description, jsonLd, noindex = false, ogType = 'website', publishedTime } = Astro.props;
const S = getSettings();
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname + Astro.url.search, siteOrigin).href;
const ogImage = new URL('/img/og.png', siteOrigin).href;
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={S.site_name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="ru_RU">
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="theme-color" content="#0B1410">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/golos-cyrillic-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/unbounded-cyrillic-600.woff2" as="font" type="font/woff2" crossorigin>
  {ldList.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body data-page={page}>
  <a class="skip" href="#main">Перейти к содержанию</a>
  <Header page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Dock />
  <Modals />
  <script>import '../client/global.ts';</script>
</body>
</html>
