---
import { getSettings } from '../server/settings.ts';
const S = getSettings();
const E0 = S.phones_extra[0];
const E1 = S.phones_extra[1];
---
<footer class="ftr">
  <div class="container ftr-grid">
    <div class="ftr-about">
      <a class="logo" href="/"><img src="/img/logo.svg" alt="" width="40" height="40"><span class="logo-t">{S.site_name}<b>{S.city} · {S.address_short}</b></span></a>
      <p>Автосервис и шиномонтаж на Западном: колёса, ремонт и обслуживание, диагностика. Сначала смета — потом ремонт.</p>
    </div>
    <div>
      <h4>Меню</h4>
      <ul><li><a href="/">Главная</a></li><li><a href="/about">О компании</a></li><li><a href="/services">Услуги</a></li><li><a href="/appointment">Запись</a></li><li><a href="/news">Новости и акции</a></li><li><a href="/contacts">Контакты</a></li></ul>
    </div>
    <div>
      <h4>Услуги</h4>
      <ul>
        <li><a href="/services/shinomontazh">Шиномонтаж</a></li>
        <li><a href="/services/balansirovka">Балансировка и диски</a></li>
        <li><a href="/services/to-maslo">ТО и замена масла</a></li>
        <li><a href="/services/hodovaya-tormoza">Ходовая и тормоза</a></li>
        <li><a href="/services/elektrika">Электрика и диагностика</a></li>
        <li><a href="/services">Все услуги</a></li>
      </ul>
    </div>
    <div>
      <h4>Контакты</h4>
      <ul class="ftr-contacts">
        <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span><b>{S.address_full}</b><br>{S.landmark}</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span><b>{S.hours}</b></span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg><span><a href={`tel:${S.phone_main_tel}`} data-track="call_click"><b>{S.phone_main}</b></a></span></li>
        {E0?.tel && <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg><span>{E0.title ? `${E0.title}: ` : ''}<a href={`tel:${E0.tel}`} data-track="call_click">{E0.display || E0.tel}</a></span></li>}
        {E1?.tel && <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg><span>{E1.title ? `${E1.title}: ` : ''}<a href={`tel:${E1.tel}`} data-track="call_click">{E1.display || E1.tel}</a></span></li>}
        <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 4.5 2.8 11.3c-.9.3-.9 1.6.1 1.8l4.6 1.2 1.8 5.4c.3.8 1.3 1 1.8.3l2.5-3 4.6 3.4c.7.5 1.7.1 1.9-.7l3.2-14c.2-1-.7-1.8-1.8-1.2z"/><path d="m7.5 14.3 11-7.8-8.4 9.4"/></svg><span>Telegram: <a href={`${S.telegram_url}`} data-track="telegram_click">{S.telegram_phone}</a></span></li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg><span><a href={`mailto:${S.email}`}>{S.email}</a></span></li>
      </ul>
    </div>
  </div>
  <div class="container ftr-legal">
    <span>{S.legal.name} · ИНН {S.legal.inn} · ОГРНИП {S.legal.ogrnip}</span>
    <span>
      <button type="button" data-modal="policy">Политика конфиденциальности</button> ·
      <button type="button" data-modal="consent">Согласие на обработку ПД</button> · © {new Date().getFullYear()}
    </span>
  </div>
</footer>
