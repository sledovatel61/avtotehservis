# ─── Основное ────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://example.ru

# ─── База данных ─────────────────────────────────────────────
# postgresql://user:password@db:5432/avtotehservis?schema=public
DATABASE_URL=

# ─── Авторизация админки ─────────────────────────────────────
AUTH_SECRET=            # openssl rand -base64 32
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=    # argon2id, генерируется скриптом npm run hash-password
TOTP_ISSUER=AvtoTehServis

# ─── Почта (Unisender Go / Яндекс 360 / SMTP хостера) ────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Сайт АвтоТехСервис <site@example.ru>"
MAIL_TO=info@example.ru
MAIL_REPLY_TO=

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # получить через getUpdates после /start

# ─── Загрузки ────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_PHOTO_MB=20
MAX_VIDEO_MB=150
MAX_STORAGE_GB=20

# ─── Антиспам (опционально) ──────────────────────────────────
SMARTCAPTCHA_SERVER_KEY=
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
RATE_LIMIT_LEADS_PER_10MIN=5

# ─── Аналитика ───────────────────────────────────────────────
NEXT_PUBLIC_METRIKA_ID=

# ─── Контакты (публичные) ────────────────────────────────────
NEXT_PUBLIC_PHONE=+79289065700
NEXT_PUBLIC_WHATSAPP=79289065700
NEXT_PUBLIC_TELEGRAM=
NEXT_PUBLIC_ADDRESS=Ростов-на-Дону, ул. Портовая, 439
NEXT_PUBLIC_LAT=47.193068
NEXT_PUBLIC_LON=39.648295
